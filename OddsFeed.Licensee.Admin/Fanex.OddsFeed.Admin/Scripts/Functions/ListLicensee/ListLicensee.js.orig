var _systemID = 0;
var _systemName = "";

var gridOptions
    , PageIndex = 0
    , PageSize = 10;

$(document).ready(function () {
    var gridOptions;
    $('#PageSize').val(PageSize);
    $('#PageIndex').val(PageIndex);
    Submit();

    $("#SystemName").keyup(function (e) {
        if (e.keyCode == $.ui.keyCode.ENTER) {
            Submit();
        }
    });
});

function Submit() {
    $.ajax({
        url: "GetLicenseeByName",
        type: "POST",
        data: $('#myForm').serialize(),
        success: function (result) {
            result = result.replace("\n", "<\/br>", "g");
            result = eval(result);
            gridOptions =
            {
                columns: [
                    { HeaderText: "#", Width: 50, Name: "Row", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "SystemID", Width: 100, Name: "SystemID", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "Licensee Name", Width: 200, Name: "SystemName", HeaderAlign: "center", CellAlign: "center", TdClass: "boldusername" },
                    { HeaderText: "Created Date", Width: 220, Name: "CreatedDate", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "Last Update", Width: 220, Name: "LastUpdate", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "Creator", Width: 162, Name: "Creator", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "Active", Width: 80, Name: "IsActive", HeaderAlign: "center", CellAlign: "center" },
                    { HeaderText: "Action", Width: 80, Name: "Action", HeaderAlign: "center", CellAlign: "center" }
                ],
                bodyRows: result[0].data,
                hideYBackGroundScroller: true,
                gridExpandHeight: 150,
                showPager: true,
                customPager: true,
                pagerOption: {
                    itemsPerPage: PageSize,
                    currentPage: PageIndex,
                    totalItem: result[1].totalItem,
                    itemsPerPageArray: [10, 20, 50, 100, 500],
                    pagerSelectCallBack: ReRenderAfterPaged
                },
                allowTruncate: true
            };

            // Add function column
            for (var i = 0; i < gridOptions.bodyRows.length; i++) {
                // Modify "Active" column                
                gridOptions.bodyRows[i].Columns[6].Row = i;
                gridOptions.bodyRows[i].Columns[6].CustomCellRender = ActiveColumn;

                // Modify "Action" column
                gridOptions.bodyRows[i].Columns.push({ Name: "Action", Row: i });
                gridOptions.bodyRows[i].Columns[7].CustomCellRender = ActionColumn;
            }

            $("#SearchResult").fanexGrid(gridOptions);
            $("#SearchResult").fanexGrid("hideColumns", gridOptions, [1]);

        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(xhr);
        },
        complete: function (jqXHR, textStatus) {
        }
    });
}

function ActiveColumn(cell, cellFormated) {
    var partnerId = gridOptions.bodyRows[cell.Row].Columns[1].Value;
    if (cell.Value == "True") {
        return "<img class='ico-tick' alt='' src='/OddsFeedAdmin/App_Themes/Default/Images/blank.png'  onclick='editActive(this," + partnerId + ")'/>";
    }
    else {
        return "<img class='ico-untick' alt='' src='/OddsFeedAdmin/App_Themes/Default/Images/blank.png'  onclick='editActive(this," + partnerId + ")'/>";
    }
}

function ActionColumn(cell, cellFormated) {

    var licenseeId = gridOptions.bodyRows[cell.Row].Columns[1].Value;
    var licenseeName = gridOptions.bodyRows[cell.Row].Columns[2].Value;

    return "<div class='btn-action licenseeId_" + licenseeId + "' onclick=\"javascript:ShowAction('" + licenseeId + "','" + licenseeName + "');\"></div>";
}

function ConvertFromJsonToFanexData(jsonObject) {
    var rows = [];

    for (var i = 0; i < jsonObject.length; i++) {
        var col = []
        for (var key in jsonObject[i]) {
            col.push({ Name: key.toString(), Value: jsonObject[i][key] });
        }
        rows.push({ Columns: col });
    }

    return rows;
}

function ReRenderAfterPaged(page_index, itemsPerPage, jq) {
    if (itemsPerPage != $('#PageSize').val()) {
        $('#PageIndex').val(0);
        PageIndex = 0;
    } else {
        $('#PageIndex').val(page_index);
        PageIndex = page_index;
    }

    $('#PageSize').val(itemsPerPage);
    PageSize = itemsPerPage;

    gridOptions.pagerOption.currentPage = page_index;
    Submit();

    return false;
}


@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@using Fanex.OddsFeed.Core.Criteria.Licensee
@model CreateLicenseeCriteria
@{
    ViewBag.Title = "Add Licensee";
    ViewBag.Nav = base.ViewBag.NavigationHome + "<span class='step'>" + ViewBag.Title + "</span>";
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Licensee/LicenseeCss")" />
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Affiliate/AffiliateCss")" />
}
@section Scripts
{
    <script type="text/javascript" src="@BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Functions/ListLicensee/AddLicenseeJs")"></script>
    <script type="text/javascript">
        var viewResources = {
            Error_LicenseeNameContent: '@ViewResources.Error_LicenseeNameContent',
            Error_LicenseeNameRequired: '@ViewResources.Error_LicenseeNameRequired',
            Error_LicenseeNameLength: '@ViewResources.Error_LicenseeNameLength',
            Error_Licensee_Existed: '@ViewResources.Error_Licensee_Existed',
            Error_EmailRequired: '@ViewResources.Error_EmailRequired',
            Error_EmailContent: '@ViewResources.Error_EmailContent',
            Error_Require_OddType: '@ViewResources.Error_Require_OddType',
            Error_Require_Deadball_or_Outright: '@ViewResources.Error_Require_Deadball_or_Outright',
            Error_Require_Language: '@ViewResources.Error_Require_Language',
            Error_Require_Sport: '@ViewResources.Error_Require_Sport',
            Error_Require_Country: '@ViewResources.Error_Require_Country',
            Error_Require_Market: '@ViewResources.Error_Require_Market',
            Error_Require_League: '@ViewResources.Error_Require_League',
            Error_Require_Outright: '@ViewResources.Error_Require_Outright',
            Error_Require_NumberOfIPs: '@ViewResources.Error_Require_NumberOfIPs',
            MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
        };
    </script>
}
<div class="infor">
    <span class="infor-ic">&nbsp;</span><span class="infor-text">
        The wizard will help you to create a new licensee in your licensee system.
    </span>
</div>
<div class="newline">&nbsp;</div>
<div class="result-message-box hidden"></div>
<div class="step-reg">
    <div id="panelStep1" class="step-active licensee-info-settings">
        <span class="firstLetter">1</span>
        <span class="normal">Licensee<br /> Information Settings</span>
    </div>
    <div id="panelStep2" class="step-inactive">
        <span class="firstLetter">2</span>
        <span class="normal">Authentication<br /> Settings</span>
    </div>
    <div id="panelStep3" class="step-inactive">
        <span class="firstLetter">3</span>
        <span class="normal">Profile<br /> Settings</span>
    </div>
</div>
<div class="newline">&nbsp;</div>
@using (Html.BeginForm("Home", "Index", FormMethod.Post, new { id = "formLicensee" }))
{
    <div id="step1" class="step">
        <h2>Step 1: Licensee Information Settings</h2>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)
        </h3>
        <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
        </div>
        <div class="newline">&nbsp;</div>
        <div class="form" style="width: auto;">
            <div class="row licensee-name">
                <div class="grid3">
                    @Html.LabelFor(m => m.SystemName, "Licensee Name")
                </div>
                <div class="grid7">
                    @Html.TextBoxFor(m => m.SystemName, new { maxlength = "50" })
                </div>
                <div class="gird1" style="text-align: left">
                    <span class="red">(*)</span>
                </div>
            </div>
            <div class="row licensee-selection hide">
                <div class="grid3">
                    @Html.LabelFor(m => m.LicenseeID, "Licensee Name")
                </div>
                <div class="grid6">
                    @Html.DropDownListFor(m => m.LicenseeID, (IEnumerable<SelectListItem>)ViewBag.LicenseesList)
                </div>
            </div>
            <div class="row contact-email">
                <div class="grid3">
                    @Html.LabelFor(m => m.ContactEmail, "Contact Email")
                </div>
                <div class="grid7">
                    @Html.TextBoxFor(m => m.ContactEmail, new { maxlength = "100" })
                </div>
                <div class="gird1" style="text-align: left">
                    <span class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(m => m.IsActive, "Active")
                </div>
                <div class="grid6">
                    @Html.CheckBoxFor(m => m.IsActive)
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.Label("AddExistingLicensee", "Add Exists")
                </div>
                <div class="grid6">
                    @Html.CheckBoxFor(m => m.AddExistingLicensee)
                </div>
            </div>
            <div class="row">
                <div class="grid2"></div>
                <div class="grid2">
                    <input id="step1Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step1Next" type="button" value="Next" />
                </div>
            </div>
        </div>
    </div>
    <div id="step2" class="step hide">
        <h2>Step 2: Authentication Settings</h2>
        <h3>Each affiliate can only access our XML Odds Feeds data under allowed list of domains and IPs</h3>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequired)
        </h3>
        <h3 id="errorStep2_NumberOfIPs">Maximum number of IPs = @ViewBag.NumberOfIPs</h3>
        <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true"></div>
        <div class="form2" style="width: auto;">
            <div class="row3">
                <div class="grid2" style="line-height: 150px; text-align: center">
                    @Html.LabelFor(m => m.DomainList, "Domains")
                </div>
                <div class="grid9" style="height: 225px; border-style: solid; border-width: 1px;
                    border-color: #C8C8C8">
                    <div class="grid6" style="width: 305px">
                        <div class="row">@Html.Label(ViewResources.DomainList)</div>
                        <div class="row2">
                            <div class="grid4" style="overflow: auto; border: thin none; height: 145px; width: 300px;">
                                @Html.ListBox("ListDomain", (IEnumerable<SelectListItem>)ViewBag.DomainList, new { style = "width:300px;", size = 8 })
                            </div>
                        </div>
                        <div class="row">
                            <div class="grid4" style="text-align: left; margin-top: 0px">
                                @Html.Label("leftShowing", ViewResources.Showing, new { id = "showingDomainListId" })
                            </div>
                        </div>
                    </div>
                    <div class="grid2">
                        <div class="row"></div>
                        <div class="row domainsActionGroup " style="margin-top: 15px; margin-left: -25px">
                            <span id="btnRight" class="arrow right"></span>
                            <br />
                            <span id="btnDoubleRight" class="arrow doubleright"></span>
                            <br />
                            <span id="btnLeft" class="arrow left"></span>
                            <br />
                            <span id="btnDoubleLeft" class="arrow doubleleft"></span>
                        </div>
                    </div>
                    <div class="grid6" style="width: 305px">
                        <div class="row">
                            @Html.Label(ViewResources.AssignedDomains)
                        </div>
                        <div class="row2">
                            <div class="grid4" style="overflow: auto; border: thin none; height: 145px; width: 300px;">
                                @Html.ListBox("AssignedDomainList", new List<SelectListItem>(), new { style = "width:300px;", size = 8 })
                            </div>
                        </div>
                        <div class="row">
                            <div class="grid4" style="text-align: left; margin-top: 0px">
                                @Html.Label("rightShowing", ViewResources.Showing, new { id = "showingAssignedDomainId" })
                            </div>
                        </div>
                    </div>
                    <div class="grid1" style="line-height: 150px; text-align: left">
                        <span class="red">(*)</span>
                    </div>
                </div>
            </div>
            @Html.HiddenFor(m => m.DomainList)
            <div id="IpDiv" class="row2" style="margin-top: 35px;">
                <div class="grid2" style="line-height: 70px; text-align: center">
                    <label for="id2">@ViewResources.IP</label>
                </div>
                <div class="grid8">
                    <table id="IpTable" style="width: 100%">
                        <thead>
                            <tr>
                                <th style="width: 40%">
                                    <label style="text-align: center">@ViewResources.IPFrom</label>
                                </th>
                                <th style="width: 40%">
                                    <label style="text-align: center">@ViewResources.IPTo</label>
                                </th>
                                <th style="width: 10%">
                                    <label style="text-align: center">@ViewResources.Action</label>
                                    <span id="addNewIP" title="Add" class="action addnew"></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input name="FromIP" type="text" />
                                </td>
                                <td>
                                    <input name="ToIP" type="text" />
                                </td>
                                <td>
                                    <span style="padding-left: 30px"></span>
                                    <span title="Delete" class="action del" onclick="removeRowTemporary(this);"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            @Html.HiddenFor(m => m.ListIPFrom)
            @Html.HiddenFor(m => m.ListIPTo)
            <div class="row">
                <div class="grid2"></div>
                <div class="grid2">
                    <input id="step2Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step2Previous" type="button" value="Previous" />
                </div>
                <div class="grid2">
                    <input id="step2Next" type="button" value="Next" />
                </div>
            </div>
        </div>
    </div>
    <div id="step3" class="step hide">
        <h2>Step 3: Profile Settings</h2>
        <h3>Profile will show which data (sports, markets, results, ...) affiliate should have in their xml stream.</h3>
        <h3>@Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
        <div id="errorStep3" class="validation-summary-errors" data-valmsg-summary="true"></div>
        <div class="form2" style="width: auto;">
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.OddsType, ViewResources.OddsType)
                </div>
                @Html.CheckBoxListFor(m => m.OddsType,
                    (IEnumerable<SelectListItem>)ViewBag.OddsTypeList,
                    new { @Class = "oddstype" },
                    showNameAttribute: false)
                @Html.HiddenFor(m => m.OddsType)
                @Html.CheckBoxFor(m => m.OddsTypeFlag)
                @Html.LabelFor(m => m.OddsTypeFlag, "Editable", new { @Class = "font-normal" })
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.OddsRegion, ViewResources.OddsStyle)
                </div>
                @Html.DropDownListFor(m => m.OddsRegion, (IEnumerable<SelectListItem>)ViewBag.OddsStyleList)
                @Html.CheckBoxFor(m => m.OddsRegionFlag)
                @Html.LabelFor(m => m.OddsRegionFlag, "Editable", new { @Class = "font-normal" })
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.OddsDelayTimes, ViewResources.OddsDelayTime)
                </div>
                <div class="grid7">
                    @Html.LabelFor(m => m.DeadballDelayTimes, ViewResources.Deadball, new { @class = "font-normal" })
                    @Html.DropDownListFor(m => m.DeadballDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                    @Html.LabelFor(m => m.LiveDelayTimes, "Live", new { @class = "font-normal" })
                    @Html.DropDownListFor(m => m.LiveDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                    @Html.LabelFor(m => m.OutrightDelayTimes, ViewResources.Outright, new { @class = "font-normal" })
                    @Html.DropDownListFor(m => m.OutrightDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                </div>
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.ResultDelayTimes, ViewResources.ResultDelayTime)
                </div>
                <div class="grid7">
                    @Html.DropDownListFor(m => m.ResultDelayTimes, (IEnumerable<SelectListItem>)ViewBag.ResultDelayTimeList, new { @style = "width: 50px" })
                </div>
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.NumberOfIPs, ViewResources.NumberOfIPs)
                </div>
                @Html.TextBoxFor(m => m.NumberOfIPs, new { @style = "width: 50px", @min = 0 })
                <div class="grid1" style="float: none;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.LanguageList, ViewResources.Languages)
                </div>
                @Html.CheckBoxListFor(m => m.LanguageList, (IEnumerable<SelectListItem>)ViewBag.LanguageIDList, new { @Class = "language" }, false)
                @Html.HiddenFor(m => m.LanguageList)
                @Html.CheckBoxFor(m => m.LanguageListFlag)
                @Html.LabelFor(m => m.LanguageListFlag, "Editable", new { @Class = "font-normal" })
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
            <div class="row3">
                @Html.HiddenFor(m => m.SportIDList)
                <div class="grid4" style="line-height: 170px; text-align: right">
                    <label for="chkAllMajorSports">
                        @ViewResources.MajorSports
                        <input class="hidden" type="checkbox" id="chkAllMajorSports" />
                    </label>
                </div>
                <div class="grid7" style="line-height: 170px; text-align: left">
                    <label class="font-normal">
                        @Html.CheckBoxListFor(m => m.SportIDList,
                            ViewBag.MajorSportList as IEnumerable<SelectListItem>,
                            new { @Class = "chkMajorSport" },
                            false)
                    </label>
                </div>
                <div class="grid4" style="line-height: 170px; text-align: right">
                    <label for="chkAllSports">@ViewResources.MinorSports</label>
                    <input type="checkbox" id="chkAllMinorSports" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="minorSport-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.SportIDList,
                            ViewBag.MinorSportList as IEnumerable<SelectListItem>,
                            new { @Class = "chkMinorSport" },
                            false)
                    </div>
                </div>
                <div class="grid3" style="line-height: 170px; text-align: left">
                    @Html.CheckBoxFor(m => m.SportIDListFlag)
                    @Html.LabelFor(m => m.SportIDListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 170px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row3">
                <div class="grid4" style="line-height: 170px; text-align: right">
                    @Html.LabelFor(m => m.CountryCodeList, "Countries", new { @for = "chkAllCountries" })
                    <input type="checkbox" id="chkAllCountries" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="country-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.CountryCodeList,
                            (IEnumerable<SelectListItem>)ViewBag.CountriesList,
                            new { @class = "chkCountry" },
                            false)
                        @Html.HiddenFor(m => m.CountryCodeList)
                    </div>
                </div>
                <div class="grid3" style="line-height: 170px; text-align: left">
                    @Html.CheckBoxFor(m => m.CountryCodeListFlag)
                    @Html.LabelFor(m => m.CountryCodeListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 170px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div id="League" class="row3">
                @Html.Partial("_LeaguePartialView", new GetLeagueCriteria
                {
                    SportIDList = Model.SportIDList,
                    LeagueIDList = Model.LeagueIDList,
                    LeagueIDListFlag = Model.LeagueIDListFlag,
                    CountryCodeList = Model.CountryCodeList,
                    LeagueKeyword = Model.LeagueKeyword,
                    LeagueKeywordFlag = Model.LeagueKeywordFlag
                })
            </div>
            <div id="Outrights" class="row3" style="max-height: 210px">
                @Html.Partial("_OutrightPartialView", new GetOutRightCriteria
                {
                    SportIDList = Model.SportIDList,
                    OutRightIDList = Model.OutRightIDList,
                    CountryCodeList = Model.CountryCodeList,
                    LeagueKeyword_O = Model.LeagueKeyword_O,
                    LeagueKeyword_OFlag = Model.LeagueKeyword_OFlag
                })
            </div>
            <div id="Market" class="row3">
                @Html.HiddenFor(m => m.BetTypeIDList)
                <div class="grid4" style="line-height: 170px; text-align: right">
                    <label for="chkAllMajorMarkets">@ViewResources.MajorMarkets</label>
                    <input type="checkbox" id="chkAllMajorMarkets" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="majormarket-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList,
                            ViewBag.MajorBettypesList as IEnumerable<SelectListItem>,
                            new { @Class = "chkMajorMarket" },
                            false)
                    </div>
                </div>
                <div class="grid4" style="line-height: 170px; text-align: right">
                    <label for="chkAllMinorMarkets">@ViewResources.MinorMarkets</label>
                    <input type="checkbox" id="chkAllMinorMarkets" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="minorMarket-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList,
                            ViewBag.MinorBettypesList as IEnumerable<SelectListItem>,
                            new { @Class = "chkMinorMarket" },
                            false)
                    </div>
                </div>
                <div class="grid3" style="line-height: 170px; text-align: left">
                    @Html.CheckBoxFor(m => m.BettypeIDListFlag)
                    @Html.LabelFor(m => m.BettypeIDListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 170px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid4"></div>
                <div class="grid2">
                    <input id="step3Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step3Previous" type="button" value="Previous" />
                </div>
                <div class="grid2">
                    <input id="step3Done" type="button" value="Done" />
                </div>
            </div>
        </div>
    </div>
}
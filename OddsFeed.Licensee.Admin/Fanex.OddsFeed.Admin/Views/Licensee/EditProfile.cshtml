@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@using Fanex.OddsFeed.Core.Criteria.Licensee;
@model EditLicenseeProfileCriteria
@{
    ViewBag.Title = " Edit Licensee Odds Profile";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                             "<a class='step' href='" + base.ViewBag.CurrentDomain + "/Licensee/ListLicensee'>Licensee list</a>" +
                             "<span class='step'>" + ViewBag.Title + ViewBag.CurrentSystem + "</span>";
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Affiliate/AffiliateCss")" />
}
@section Scripts
{
    <script src="~/Scripts/Functions/ListLicensee/CommonLicensee.js" type="text/javascript"></script>
    <script src="~/Scripts/Functions/ListLicensee/EditLicenseeProfile.js" type="text/javascript"></script>
    <script type="text/javascript">
         var viewResources = {
             Error_Require_OddType: '@ViewResources.Error_Require_OddType',
             Error_Require_Deadball_or_Outright: '@ViewResources.Error_Require_Deadball_or_Outright',
             Error_Require_Language: '@ViewResources.Error_Require_Language',
             Error_Require_Sport: '@ViewResources.Error_Require_Sport',
             Error_Require_Country: '@ViewResources.Error_Require_Country',
             Error_Require_Market: '@ViewResources.Error_Require_Market',
             Error_Require_League: '@ViewResources.Error_Require_League',
             Error_Require_Outright: '@ViewResources.Error_Require_Outright',
             Error_Require_NumberOfIPs: '@ViewResources.Error_Require_NumberOfIPs',
             MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
         };
    </script>
}
@using (Html.BeginForm("EditProfilePost", "Licensee", FormMethod.Post, new { id = "formEditLicenseeProfile" }))
{
    <div id="step3" class="step">
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">
                Odds profile will show which
                data (sports, markets, ...) affiliate should have in their xml stream.
            </span>
        </div>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)
        </h3>
        <div class="newline">
            &nbsp;
        </div>
        <div id="errorStep3" class="validation-summary-errors hidden" data-valmsg-summary="true">
        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="form2" style="width: auto;">
            @Html.HiddenFor(m => m.SystemID)
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.OddsType, "Odds Type")
                </div>
                @Html.CheckBoxListFor(m => m.OddsType, (IEnumerable<SelectListItem>)ViewBag.OddsTypeList, new { @Class = "oddstype" }, false)
                @Html.HiddenFor(m => m.OddsType)
                @Html.CheckBoxFor(m => m.OddsTypeFlag)
                @Html.LabelFor(m => m.OddsTypeFlag, "Editable", new { @Class = "font-normal" })
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.OddsRegion, "Odds Format")
                </div>
                @Html.DropDownListFor(m => m.OddsRegion, (IEnumerable<SelectListItem>)ViewBag.OddsStyleList)
                @Html.CheckBoxFor(m => m.OddsRegionFlag)
                @Html.LabelFor(m => m.OddsRegionFlag, "Editable", new { @Class = "font-normal" })
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.DelayTimes, "Delay Time")
                </div>
                @Html.LabelFor(m => m.DeadballDelayTimes, "Deadball", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.DeadballDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                @Html.LabelFor(m => m.LiveDelayTimes, "Live", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.LiveDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                @Html.LabelFor(m => m.OutrightDelayTimes, "Outright", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.OutrightDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.NumberOfIPs, "Number of IPs")
                </div>
                @Html.TextBoxFor(m => m.NumberOfIPs, new { @style = "width: 50px", @min = 0 })
                <div class="grid1" style="float: none;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.LanguageList, "Languages")
                </div>
                @Html.CheckBoxListFor(m => m.LanguageList, (IEnumerable<SelectListItem>)ViewBag.LanguageIDList, new { @Class = "language" }, false)
                @Html.HiddenFor(m => m.LanguageList)
                @Html.CheckBoxFor(m => m.LanguageListFlag)
                @Html.LabelFor(m => m.LanguageListFlag, "Editable", new { @Class = "font-normal" })
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
            <div class="row3">
                @Html.HiddenFor(m => m.SportIDList)

                <div class="grid4" style="line-height: 270px; text-align: right">
                    <label for="chkAllMajorSports">
                        @ViewResources.MajorSports
                        <input class="hidden" type="checkbox" id="chkAllMajorSports" />
                    </label>
                </div>
                <div class="grid7" style="line-height: 270px; text-align: left">
                    <label class="font-normal">
                        @Html.CheckBoxListFor(m => m.SportIDList, ViewBag.MajorSportList as IEnumerable<SelectListItem>, new { @Class = "chkMajorSport" }, false)
                    </label>
                </div>
                <div class="grid4" style="line-height: 270px; text-align: right">
                    <label for="chkAllSports">
                        @ViewResources.MinorSports
                    </label><input type="checkbox" id="chkAllMinorSports" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="minorSport-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.SportIDList, ViewBag.MinorSportList as IEnumerable<SelectListItem>, new { @Class = "chkMinorSport" }, false)
                    </div>
                </div>
                <div class="grid3" style="line-height: 270px; text-align: left">
                    @Html.CheckBoxFor(m => m.SportIDListFlag)
                    @Html.LabelFor(m => m.SportIDListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 270px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row3">
                <div class="grid4" style="line-height: 270px; text-align: right">
                    @Html.LabelFor(m => m.CountryCodeList, "Countries", new { @for = "chkAllCountries" })
                    <input type="checkbox" id="chkAllCountries" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="country-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.CountryCodeList, (IEnumerable<SelectListItem>)ViewBag.CountriesList, new { @class = "chkCountry" }, false)
                        @Html.HiddenFor(m => m.CountryCodeList)
                    </div>
                </div>
                <div class="grid3" style="line-height: 270px; text-align: left">
                    @Html.CheckBoxFor(m => m.CountryCodeListFlag)
                    @Html.LabelFor(m => m.CountryCodeListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 270px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div id="League" class="row3">
                @Html.Partial("_LeaguePartialView", new GetLeagueCriteria()
           {
               SportIDList = Model.SportIDList,
               LeagueIDList = Model.LeagueIDList,
               LeagueIDListFlag = Model.LeagueIDListFlag,
               CountryCodeList = Model.CountryCodeList,
               LeagueKeyword = Model.LeagueKeyword,
               LeagueKeywordFlag = Model.LeagueKeywordFlag
           })
            </div>
            <div id="Outrights" class="row3" style="max-height: 210px">
                @Html.Partial("_OutrightPartialView", new GetOutRightCriteria()
           {
               SportIDList = Model.SportIDList,
               OutRightIDList = Model.OutRightIDList,
               CountryCodeList = Model.CountryCodeList,
               LeagueKeyword_O = Model.LeagueKeyword_O,
               LeagueKeyword_OFlag = Model.LeagueKeyword_OFlag
           })
            </div>
            <div id="Market" class="row3">
                @Html.HiddenFor(m => m.BetTypeIDList)
                <div class="grid4" style="line-height: 270px; text-align: right">
                    <label for="chkAllMajorMarkets">
                        @ViewResources.MajorMarkets
                    </label><input type="checkbox" id="chkAllMajorMarkets" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="majormarket-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList, ViewBag.MajorBettypesList as IEnumerable<SelectListItem>, new { @Class = "chkMajorMarket" }, false)
                    </div>
                </div>
                <div class="grid4" style="line-height: 270px; text-align: right">
                    <label for="chkAllMinorMarkets">
                        @ViewResources.MinorMarkets
                    </label><input type="checkbox" id="chkAllMinorMarkets" />
                </div>
                <div class="grid7">
                    <div class="checkbox-filter">
                        <label>Search </label>
                        <input id="minorMarket-filter" />
                    </div>
                    <div class="grid7 checkbox-list">
                        @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList, ViewBag.MinorBettypesList as IEnumerable<SelectListItem>, new { @Class = "chkMinorMarket" }, false)
                    </div>
                </div>
                <div class="grid3" style="line-height: 270px; text-align: left">
                    @Html.CheckBoxFor(m => m.BettypeIDListFlag)
                    @Html.LabelFor(m => m.BettypeIDListFlag, "Editable", new { @Class = "font-normal" })
                </div>
                <div class="grid1" style="line-height: 270px;">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid3"></div>
                <div class="grid7">
                    @Html.CheckBoxFor(m => m.ApplyAllCurrentAffiliates)
                    @Html.LabelFor(m => m.ApplyAllCurrentAffiliates, "Apply this profile for all current affiliates under", new { @Style = "color:Red" })
                </div>
            </div>
            <div class="row">
                <div class="grid4">
                </div>
                <div class="grid2">
                    <input id="step3Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step3Done" type="button" value="Save" />
                </div>
            </div>
        </div>
    </div>
}
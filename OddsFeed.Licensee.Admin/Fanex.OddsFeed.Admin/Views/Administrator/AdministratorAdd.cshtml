@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.Administrator.InsertAdminCriteria
@{
    ViewBag.Title = "Add Administrator";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<span class='step'>" + ViewBag.Title + "</span>";
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Administrator/AdministratorCss")" />
    <style type="text/css">
        .ui-autocomplete li:hover
        {
            font-size: 14px;
            font-weight: bold;
            background-color: #c8c8c8;
        }
    </style>
}
@section Scripts
{
    <script type="text/javascript" src="@BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Administrator/AddAdministratorJs")" ></script>
}
<div class="infor">
    <span class="infor-ic">&nbsp;</span><span class="infor-text">The wizard will help you to create a new Administrator in your licensee system.</span>
</div>
<div class="newline">&nbsp;</div>
<div class="step-reg">
    <div id="panelStep1" class="step-active">
        <span class="firstLetter">1</span><span class="normal">Admin Information Settings</span>
    </div>
    <div id="panelStep2" class="step-inactive" style="display: none">
        <span class="firstLetter">2</span><span class="normal">Licensee<br />Selection</span>
    </div>
    <div class="newline">&nbsp;</div>
    <div id="step1" class="step">
        <h2>Step 1: Admin Information Settings</h2><h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
        <div id="error-message-box" class="error-message-box hidden">
        </div>
        <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="nameReqErr" style="display: none">@ViewResources.Error_UserNameRequired</li>
                <li id="nameInvalidErr" style="display: none">@ViewResources.Error_UserNameContent</li>
                <li id="nameLengErr" style="display: none">@ViewResources.Error_UserNameLength</li>
                <li id="pwdReqErr" style="display: none">@ViewResources.Error_PasswordRequired</li>
                <li id="pwdLengErr" style="display: none">@ViewResources.Error_PasswordLength</li>
                <li id="pwdContentErr" style="display: none">@ViewResources.InvalidFieldValidationPassword</li>
                <li id="confirmPwdReqErr" style="display: none">@ViewResources.Error_ConfirmPasswordRequired</li>
                <li id="confirmPwdLengErr" style="display: none">@ViewResources.Error_ConfirmPasswordLength</li>
                <li id="confirmPwdContentErr" style="display: none">@ViewResources.InvalidFieldValidationConfirmPassword</li>
                <li id="pwdNotMatchErr" style="display: none">@ViewResources.Error_PasswordNotMatch</li>
                <li id="importUsnReqErr" style="display: none">You must input an existed admin's username to import.</li>
                <li id="importUsnNotExistedErr" style="display: none">@ViewResources.Error_UserNotExist</li>
                <li id="emailReqErr" style="display: none">@ViewResources.Error_EmailRequired</li>
                <li id="emailInvalidErr" style="display: none">@ViewResources.Error_EmailContent</li>
                <li id="nameExistedErr" style="display: none">@ViewResources.Error_Exist_AdministratorName</li>
            </ul>
        </div>
        <div id="success-message-box" class="success-message-box hidden">
            <ul>
                <li>The administrator's information has been added successfully!</li>
            </ul>
        </div>
        <div class="newline">&nbsp;</div>
        <div class="form480" id="subForm" style="height: 20px; vertical-align: middle; width: auto;">
            <div class="grid4">
                <input type="radio" name="newORexisted" value="1" checked>Add New&nbsp;&nbsp;&nbsp;&nbsp;
                <input type="radio" name="newORexisted" value="2">Import</div>
            <div class="grid6 hide" style="margin-top: -3px" id="searchToImport">
                <input type="text" id="txtUsernameImport" style="width: 150px" onkeyup="StartAutoSuggesttion()" />
                <input id="btnImport" type="submit" value="GO" style="width: 40px" />
            </div>
        </div>
        <div class="newline">&nbsp;</div>
        <div class="form480" id="mainForm" style="width: auto;"> 
            <div class="row">
                <div class="grid3">
                    <label for="id1">@ViewResources.Username</label></div>
                <div class="grid4">
                    <input type="text" id="txtUsername" />
                </div>
                <div class="gird1">
                    <span style="padding-left: 160px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id1">@ViewResources.Password</label>
                </div>
                <div class="grid4">
                    <input type="password" id="txtPwd" />
                </div>
                <div class="gird1">
                    <span style="padding-left: 160px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id1">@ViewResources.Confirm_Password</label>
                </div>
                <div class="grid4">
                    <input type="password" id="txtConfirmPwd" />
                </div>
                <div class="gird1">
                    <span style="padding-left: 160px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id1">@ViewResources.First_Name</label>
                </div>
                <div class="grid4">
                    <input type="text" id="txtFirstname" />
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id2">@ViewResources.Last_Name</label>
                </div>
                <div class="grid4">
                    <input type="text" id="txtLastname" />
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id2">@ViewResources.Email</label>
                </div>
                <div class="grid4">
                    <input type="text" id="txtEmail" />
                </div>
                <div class="gird1">
                    <span style="padding-left: 160px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id2">@ViewResources.Role</label>
                </div>
                <div class="grid7">
                    <input type="radio" name="role" value="1" checked />Account Manager&nbsp;&nbsp;&nbsp;&nbsp;
                    <input type="radio" name="role" value="2" />Licensee
                </div>
            </div>
            <div class="row">
                <div class="grid3"></div>
                <div class="grid2">
                    <input id="step1Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step1Next" type="button" value="Next" style="display: none" />
                    <input id="step1Done" type="button" value="Done" />
                </div>
            </div>
        </div>
    </div>
    <div id="step2" class="step hide">
        <h2>Step 2: Licensee Selection</h2>
        <h3>Assign Licensee(s) to Administrator</h3>
        <h3>@Html.Raw(ViewResources.HtmlTemplate_InputRequired)</h3>
        <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="licenseeReqErr">The Licensee field is required.</li>
            </ul>
        </div>
        <div id="success-message-box" class="success-message-box hidden">
            <ul>
                <li>The administrator's information has been added successfully!</li>
            </ul>
        </div>
        <div class="error-message-box hidden"></div>
        <input type="hidden" id="sportsFlag" value="@ViewBag.SportsFlag" />
        <div class="form480" style="width: auto;">
            <div class="row3">
                <div class="grid3" style="line-height: 170px; text-align: right">
                    <label for="chkAllSystem">@ViewResources.Licensee</label><input type="checkbox" id="chkAllSystem" />
                </div>
                <div class="grid6 licenseeList" style="text-align: left; border-style: solid; border-width: 1px;
                    border-color: #C8C8C8; overflow: scroll">
                    @Html.CheckBoxDropDownList("chkSystem", ViewBag.SystemList as IEnumerable<SelectListItem>, new { @class = "chkSystem" })
                </div>
                <div class="grid1" style="line-height: 170px; text-align: left">
                    <span class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3"></div>
                <div class="grid2">
                    <input id="step2Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step2Previous" type="button" value="Previous" />
                </div>
                <div class="grid2">
                    <input id="step2Done" type="button" value="Done" />
                </div>
            </div>
        </div>
    </div>
</div>

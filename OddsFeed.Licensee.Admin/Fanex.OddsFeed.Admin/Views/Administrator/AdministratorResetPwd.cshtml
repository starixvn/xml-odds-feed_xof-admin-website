@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model  Fanex.OddsFeed.Core.Criteria.Administrator.UpdateAdminPasswordCriteria
@{
    ViewBag.Title = "Reset Password";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<a class='step' href='" + base.ViewBag.CurrentDomain + "/Administrator/AdministratorList'>Administrator List</a>" +
                         "<span class='step'>" + ViewBag.Title + ViewBag.CurrentUser + "</span>";
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Scripts
{
    <script type="text/javascript" src="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Administrator/EditAdministratorJs")" ></script>
}
<div id="editStep1">
    @using (Html.BeginForm())
    {
        if (ViewBag.HasEditPermission == null || ViewBag.HasEditPermission == true)
        { 
        <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="newPassReqErr" style="display: none">@ViewResources.Error_NewPasswordRequired</li>
                <li id="newPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationNewPassword</li>
                <li id="newPassLengErr" style="display: none">@ViewResources.Error_NewPasswordLength</li>
                <li id="confirmPassReqErr" style="display: none">@ViewResources.Error_ConfirmPasswordRequired</li>
                <li id="confirmPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationConfirmPassword</li>
                <li id="confirmPassLengErr" style="display: none">@ViewResources.Error_ConfirmPasswordLength</li>
                <li id="pwdNotMatchErr" style="display: none">@ViewResources.Error_PasswordNotMatch</li>
            </ul>
        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">@Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</span>
        </div>
        <div class="newline">
            &nbsp;</div>
        
        <div class="form">
            @Html.HiddenFor(a => a.UserID)
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.Password, "New Password")
                </div>
                <div class="grid4">
                    @Html.PasswordFor(a => a.Password, new { id = "txtPassword", @Style = "width:250px", autocomplete = "off" })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.ConfirmPassword, "Confirm Password")
                </div>
                <div class="grid4">
                    @Html.PasswordFor(a => a.ConfirmPassword, new { id = "txtConfirmPassword", @Style = "width:250px", autocomplete = "off" })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                </div>
                <div class="grid2">
                    <a href="@Url.Action("AdministratorList", "Administrator")" class="button">@ViewResources.Back</a>
                </div>
                <div class="grid2">
                    <input id="Save" class="resetPassword" type="button" value="@ViewResources.Save" />
                </div>
            </div>
        </div>
        }
    }
</div>

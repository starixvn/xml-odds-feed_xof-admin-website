@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model  Fanex.OddsFeed.Core.Criteria.Affiliate.UpdateSubAccCriteria
@{
    ViewBag.Title = "Edit sub-account information";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<a class='step' href='" + base.ViewBag.CurrentDomain + "/SubAccount/List'>Sub-account list</a>" +
                         "<span class='step'>" + ViewBag.Title + ViewBag.CurrentUser + "</span>";
                          
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Scripts
{
    <script src="~/Scripts/SubAccount/EditSubAcc.js" type="text/javascript"></script>
    <script type="text/javascript">
        var viewResources = {
            ActionResult_Success_UpdateSubAccount: '@ViewResources.ActionResult_Success_UpdateSubAccount'
        };        
    </script>
}
<div id="editStep1">
    <div class="infor">
        <span class="infor-ic"></span><span class="infor-text">@Html.Raw(ViewResources.HtmlTemplate_InputRequired)</span>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
        <ul>
            <li id="emailReqErr" style="display: none">The Email field is required.</li>
            <li id="emailInvalidErr" style="display: none">The Email field is invalid.</li>
        </ul>
    </div>
    <div class="result-message-box hidden">
    </div>
    @Html.HiddenFor(a => a.SubAccountID)
    <div class="form">
        <div class="row">
            <div class="grid2">
                @Html.HiddenFor(a => a.SubAccountID)
                @Html.LabelFor(a => a.UserName)
            </div>
            <div class="grid5">
                @Html.TextBoxFor(a => a.UserName, new { id = "txtUsername", @disabled = "true" })
            </div>
            @*<div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>*@
        </div>
        <div class="row">
            <div class="grid2">
                @Html.LabelFor(a => a.FirstName)
            </div>
            <div class="grid5">
                @Html.TextBoxFor(a => a.FirstName, new { id = "txtFirstName", @maxlength = 50 })
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                @Html.LabelFor(a => a.LastName)
            </div>
            <div class="grid5">
                @Html.TextBoxFor(a => a.LastName, new { id = "txtLastName", @maxlength = 50 })
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                @Html.LabelFor(a => a.Email)
            </div>
            <div class="grid7">
                @Html.TextBoxFor(a => a.Email, new { id = "txtEmail", @maxlength = 50 })
            </div>
            <div class="grid1">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                @Html.LabelFor(a => a.IsActive, new { @for = "chkIsActive" })
            </div>
            <div class="grid5">
                @Html.CheckBoxFor(a => a.IsActive, new { id = "chkIsActive" })
            </div>
        </div>
        <div class="row">
        </div>
        <div class="row">
            <div class="grid2">
            </div>
            <div class="grid2">
                <a href="@Url.Action("list", "subaccount")" class="button">@ViewResources.Cancel</a>
            </div>
            <div class="grid2">
                <input id="Save" type="button" value="@ViewResources.Save" />
            </div>
        </div>
    </div>
</div>

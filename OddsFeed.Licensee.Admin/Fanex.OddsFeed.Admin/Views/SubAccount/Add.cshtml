@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model  Fanex.OddsFeed.Core.Criteria.Affiliate.InsertSubAccCriteria
@{
    ViewBag.Title = "Add sub-account";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                             "<span class='step'>" + ViewBag.Title + "</span>";    
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Scripts
{
    <script type="text/javascript" src="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Scripts/SubAcc/AddSubAccJs")" ></script>
}
@using (Html.BeginForm())
{    
    <div class="infor">
        <span class="infor-ic">&nbsp;</span><span class="infor-text">The wizard will help you
            to create a new sub-account in your licensee system.</span></div>
    <div class="newline">
        &nbsp;</div>
    if (ViewBag.Success == true)
    {   
    <div id="success-message-box" class="success-message-box">
        <ul>
            <li>The Sub-acount has been created successfully!</li>
        </ul>
    </div>     
    <input type="hidden" id="successed" value="true" />
    }
    else if (!string.IsNullOrEmpty(ViewBag.Error))
    {
    <div id="error-message-box" class="error-message-box">
        <ul>
            <li>@ViewBag.Error</li>
        </ul>
    </div>
    }
    
    <div class="step-reg">
        <div id="panelStep1" class="step-active">
            <span class="firstLetter">1</span><span class="normal">Sub-account<br />
                Information</span></div>
        <div id="panelStep2" class="step-inactive">
            <span class="firstLetter">2</span><span class="normal">Licensee<br />
                Selection</span></div>
        <div id="panelStep3" class="step-inactive">
            <span class="firstLetter">3</span><span class="normal">Permission<br />
                Settings</span></div>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div id="step1" class="step">
        <h2>
            Step 1: Sub-account Information</h2>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
        <div class="result-message-box hidden">
        </div>
        <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="nameReqErr" style="display: none">@ViewResources.Error_NameRequired</li>
                <li id="nameInvalidErr" style="display: none">@ViewResources.Error_NameContent</li>
                <li id="nameLengErr" style="display: none">@ViewResources.Error_NameLength
                </li>
                <li id="passReqErr" style="display: none">@ViewResources.Error_PasswordRequired</li>
                <li id="passLengErr" style="display: none">@ViewResources.Error_PasswordLength</li>
                <li id="passWhiteSpaceErr" style="display: none">@ViewResources.Error_Content_Password</li>
                <li id="pwdNotMatchErr" style="display: none">@ViewResources.Error_PasswordNotMatch</li>
                <li id="confirmPassReqErr" style="display: none">@ViewResources.Error_ConfirmPasswordRequired</li>
                <li id="confirmPassWhiteSpaceErr" style="display: none">@ViewResources.Error_Content_ConfirmPassword</li>
                <li id="emailReqErr" style="display: none">@ViewResources.Error_EmailRequired</li>
                <li id="emailInvalidErr" style="display: none">@ViewResources.Error_EmailContent</li>
                <li id="websiteReqErr" style="display: none">@ViewResources.Error_WebsiteRequired</li>
                <li id="websiteInvalidErr" style="display: none">@ViewResources.Error_WebsiteContent
                </li>
                <li id="nameExistedErr" style="display: none">@ViewResources.Error_Exist_SubAccountName</li>
            </ul>
        </div>
        <div class="newline">
            &nbsp;</div>
        <div class="form">
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.UserName)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.UserName, new { id = "txtUserName", @maxlength = 50, autocomplete = "off" })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.Password)
                </div>
                <div class="grid5">
                    @Html.PasswordFor(a => a.Password, new { id = "txtPassword", @maxlength = 50, @Style = "width:300px" })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    <label for="id1">
                        @ViewResources.Confirm_Password</label></div>
                <div class="grid4">
                    <input type="password" id="txtConfirmPwd" style="width: 300px" /></div>
                <div class="gird1">
                    <span style="padding-left: 160px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.FirstName)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.FirstName, new { id = "txtFirstName", @maxlength = 50 })
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.LastName)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.LastName, new { id = "txtLastName", @maxlength = 50 })
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.Email)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.Email, new { id = "txtEmail", @maxlength = 50 })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                    @Html.LabelFor(a => a.IsActive, new { @for = "chkIsActive" })
                </div>
                <div class="grid5">
                    @Html.CheckBoxFor(a => a.IsActive, new { id = "chkIsActive", @checked = "checked" })
                </div>
            </div>
            <div class="row">
            </div>
            <div class="row">
                <div class="grid3">
                </div>
                <div class="grid2">
                    <input id="step1Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step1Next" type="button" value="Next" />
                </div>
            </div>
        </div>
    </div>
    
    <div id="step2" class="step hide">
        <h2>
            Step 2: Licensee Selection</h2>
        <h3>
            Assign Licensee(s) to sub-account
        </h3>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequired)</h3>
        <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="licenseeReqErr hidden">@ViewResources.Error_LicenseeRequired</li>
            </ul>
        </div>
        <input type="hidden" id="sportsFlag" value="@ViewBag.SportsFlag" />
        <div class="form548" style="width: auto;">
            <div class="row3">
                <div class="grid3" style="line-height: 170px; text-align: right">
                    <label for="chkAllSystem">
                        @ViewResources.Licensee</label><input type="checkbox" id="chkAllSystem" />
                </div>
                <div class="licenseeList grid7" style="text-align: left; border-style: solid; border-width: 1px;
                    border-color: #C8C8C8; overflow: scroll">
                    @Html.CheckBoxDropDownListFor(a => a.SystemArray, ViewBag.SystemList as IEnumerable<SelectListItem>, new { @Class = "chkSystem" })
                </div>
                <div class="grid1" style="line-height: 170px; text-align: left">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                </div>
                <div class="grid2">
                    <input id="step2Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step2Previous" type="button" value="Previous" />
                </div>
                <div class="grid2">
                    <input id="step2Next" type="button" value="Next" />
                </div>
            </div>
        </div>
    </div>
    
    <div id="step3" class="step hide">
        <h2>
            Step 3: Permission Settings</h2>
        <div id="errorStep3" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="permissionSettingsReqErr">The Permission Settings field is required.</li>
            </ul>
        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="form" style="width: auto;">
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.OddsTypeFlag, new { id = "chkOddsTypeFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.OddsTypeFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.OddsTypeFlag, new { @for = "chkOddsTypeFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.OddsStyleFlag, new { id = "chkOddsStyleFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.OddsStyleFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.OddsStyleFlag, new { @for = "chkOddsStyleFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.LanguageListFlag, new { id = "chkLanguageListFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.LanguagesFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.LanguageListFlag, new { @for = "chkLanguageListFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.SportIDListFlag, new { id = "chkSportIDListFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.SportIDListFlag, new { @for = "chkSportIDListFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.CountryCodeListFlag, new { id = "chkCountryCodeListFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.CountriesFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.CountryCodeListFlag, new { @for = "chkCountryCodeListFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                    @Html.CheckBoxFor(a => a.BetTypeIDListFlag, new { id = "chkBetTypeIDListFlag", @class = "chkPerSettings", @isDisabled = @ViewBag.MarketsFlag ? "" : "disabled" })
                </div>
                <div class="grid5">
                    @Html.LabelFor(a => a.BetTypeIDListFlag, new { @for = "chkBetTypeIDListFlag" })
                </div>
            </div>
            <div class="row">
                <div class="grid1">
                </div>
                <div class="grid2">
                    <input id="step3Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="step3Previous" type="button" value="Previous" />
                </div>
                <div class="grid2">
                    <input id="Save" type="button" value="Done" />
                </div>
            </div>
        </div>
    </div>    
}

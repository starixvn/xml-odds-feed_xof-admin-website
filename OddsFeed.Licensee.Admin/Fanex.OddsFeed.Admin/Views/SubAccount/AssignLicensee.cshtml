@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.SubAccount.AssignLicensee_SubAccCriteria
@{
    ViewBag.Title = "Assign Licensee To";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<a class='step' href='" + base.ViewBag.CurrentDomain + "/SubAccount/List'>Sub-account list</a>" +
                         "<span class='step'>" + ViewBag.Title + ViewBag.CurrentUser + "</span>";
                         
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Scripts
{
    <script src="~/Scripts/SubAccount/EditSubAcc.js" type="text/javascript"></script>
}
<div id="step2" class="step">
    @using (Html.BeginForm())
    {
        @Html.ValidationSummary()
        if (ViewBag.Success == true)
        {
        <div id="success-message-box" class="success-message-box">
            <ul>
                <li>The Sub-account's information has been updated successfully!</li>
            </ul>
        </div>     
        <input type="hidden" id="successed" value="true" />
        }
        else if (!string.IsNullOrEmpty(ViewBag.Error))
        {
        <div id="error-message-box" class="error-message-box">
            <ul>
                <li>@ViewBag.Error</li>
            </ul>
        </div>
        }
        
        <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
            <ul>
                <li id="licenseeRequiredErr" class="hidden">@ViewResources.Error_LicenseeRequired
                </li>
            </ul>
        </div>
        if (ViewBag.HasEditPermission == null || ViewBag.HasEditPermission == true)
        {   
        @Html.HiddenFor(a => a.UserID, new { id = "txtid" })  
        @Html.HiddenFor(a => a.UserName, new { id = "txtUserName" })       
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">Assign Licensee(s) to Sub-account.</span>
        </div>      
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequired)</h3>     
        <div class="newline">
            &nbsp;</div>
        <div class="form480" style="width: auto;">
            <div class="row3">
                <div class="grid3" style="line-height: 170px; text-align: right">
                    <label for="chkAllSystem">
                        @ViewResources.Licensee</label><input type="checkbox" id="chkAllSystem" checked="checked" />
                </div>
                <div class="grid6 licenseeList" style="text-align: left; border-style: solid; border-width: 1px;
                    border-color: #C8C8C8; overflow: scroll">
                    @Html.CheckBoxDropDownListFor(a => a.SystemList, ViewBag.SystemListID as IEnumerable<SelectListItem>, new { @class = "chkSystem" })
                </div>
                <div class="grid1" style="line-height: 170px; text-align: left">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
            <div class="row">
                <div class="grid3">
                </div>
                <div class="grid2">
                    <a href="@Url.Action("List", "SubAccount")" class="button">@ViewResources.Back</a>
                </div>
                <div class="grid2">
                    <input type="submit" onclick="return CheckValidation_AssignLicensee();" value="Save" value="@ViewResources.Save" />
                </div>
            </div>
        </div>
        }
    }
</div>

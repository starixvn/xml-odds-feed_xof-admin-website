@{ Layout = null; }
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>LICENSEE ADMIN - Under Maintenance</title>
    <style media="screen" type="text/css">
        body
        {
            margin: 0px 0px;
            padding: 0px;
            text-align: left;
            font-family: Tahoma;
     
        }
        .pageheader
        {
            background: #000000 url("@ViewBag.CurrentDomain/App_Themes/Default/Images/top-bg.png") repeat;
            height: 46px;
            border-top: 1px solid #f5f5f5;
            border-bottom: 1px solid #898989;
            padding-left: 19px;
            padding-right: 15px;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <div class="pageheader">
        <div style="height:100%; margin-top:10px;">
            <img src="~/App_Themes/Default/Images/logo_licensee.png" alt="" />
        </div>           
    </div>
    <div style="text-align: center; margin-top:50px;">
        <div>
            <div>
                <img src="~/App_Themes/Default/Images/tp_maintenance.png" />
                <br />
            </div>
            <table width="100%">
                <tr align="center">
                    <td align="right"><img src="~/App_Themes/Default/Images/tp_exclamation.png" /></td>
                    <td align="left" style="width:64%; font-size: 50px; color: #0072bc; vertical-align:middle;">UNDER MAINTENANCE</td>
                </tr>
            </table>
            <br />
            <table width="100%">
                <tr align="center">
                    <td></td>
                    <td align="left" style="width:65%; font-size: 12px; vertical-align:middle;">We are having server maintenance, website will be unavailable until <span class="em">@(ViewBag.UmtTo)</span> (HK Time GMT +8).</td>
                </tr>
                <tr align="center">
                    <td></td>
                    <td align="left" style="width:65%; font-size: 12px; vertical-align:middle;">Sorry for the inconveniences caused!</td>
                </tr>
            </table>
            <br />
            <div>
                <span style="font-size: 12px; color:#0072bc;">
                <a style="text-decoration:none;" href="@Url.Action("index", "login")">Back to Homepage</a></span>
                <br />
            </div>
        </div>
    </div>
    <footer>
    </footer>    
</body>
</html>
<script type="text/javascript" src="~/Scripts/Libs/jquery.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        setInterval("reCheckUM()", 5000);
    });

    function reCheckUM() {
        $.ajax({
            url: '@Url.Content("~/")' + "Tolerance/IsUnderMaintainance",
            type: "POST",
            success: function (result) {
                if (result == 'False') {
                    window.location.href = '@Url.Content("~/")' + "Login/Index";
                }
            },
            error: function (request, status, error) {
            }
        });
    }
</script>
@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.Affiliate.UpdateAffiliateCriteria
@{
    ViewBag.Title = "Edit affiliate information";
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("List", "Affiliate")">Affiliate List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Affiliate/AffiliateCss")" />
}
@section Scripts
{
    <script type="text/javascript" src="~/Scripts/Affiliate/CommonAffiliate.js"></script>
    <script type="text/javascript" src="~/Scripts/Affiliate/EditAffiliateInfo.js"></script>
    <script type="text/javascript">
        var viewResources = {
            Error_NameRequired: '@ViewResources.Error_NameRequired',
            Error_NameLength: '@ViewResources.Error_NameLength',
            Error_NameContent: '@ViewResources.Error_NameContent',
            Error_EmailRequired: '@ViewResources.Error_EmailRequired',
            Error_EmailContent: '@ViewResources.Error_EmailContent',
            Error_WebsiteRequired: '@ViewResources.Error_WebsiteRequired',
            Error_WebsiteContent: '@ViewResources.Error_WebsiteContent'
        };
    </script>
}
<div id="editStep1">
    @using (Html.BeginForm())
    {
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">@Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</span>
        </div>
        <div class="newline">
            &nbsp;
        </div>
        <div class="result-message-box hidden">
        </div>

        <div class="form">
            <div class="row">
                @Html.HiddenFor(a => a.PartnerID)
                <div class="grid2">
                    @Html.LabelFor(a => a.UserName)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.UserName, new { id = "txtUsername", @disabled = "true" })
                    @*@Html.TextBoxFor(a => a.UserName, new { id = "txtUsername", @disabled="true", autocomplete = "off", onfocus = "$(this).blur();" })  *@
                </div>
            </div>
            <div class="row">
                <div class="grid2">
                    @Html.LabelFor(a => a.Email)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.Email, new { id = "txtEmail", @maxlength = 50 })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row">
                <div class="grid2">
                    @Html.LabelFor(a => a.Website)
                </div>
                <div class="grid5">
                    @Html.TextBoxFor(a => a.Website, new { id = "txtWebsite", @maxlength = 200 })
                </div>
                <div class="gird1">
                    <span style="padding-left: 120px" class="red">(*)</span>
                </div>
            </div>
            <div class="row2">
                <div class="grid2">
                    @Html.LabelFor(a => a.Note)
                </div>
                <div class="grid5">
                    @Html.TextAreaFor(a => a.Note, new { id = "txtNote" })
                </div>
            </div>
            @* <div class="row2">
                    <div class="grid2">
                        @Html.LabelFor(a => a.Content)
                        </div>
                    <div class="grid5">
                        @Html.TextAreaFor(a => a.Content, new { id = "txtContent" })
                    </div>
                </div>*@
            <div class="row">
                <div class="grid2">
                </div>
                <div class="grid2">
                    <a href="@Url.Action("list", "affiliate")" class="button">@ViewResources.Back</a>
                </div>
                <div class="grid2">
                    <input id="editStep1Save" type="button" value="@ViewResources.Save" />
                </div>
            </div>
        </div>
    }
</div>

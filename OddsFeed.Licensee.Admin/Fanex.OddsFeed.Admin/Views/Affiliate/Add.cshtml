@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.Affiliate.InsertAffiliateCriteria
@{
    ViewBag.Title = "Add affiliate";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<span class='step'>" + ViewBag.Title + "</span>";
                         
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Affiliate/AffiliateCss")" />
}
@section Scripts
{
    <script type="text/javascript" src="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Affiliate/AddAffiliateJs")" ></script>
    <script type="text/javascript" src="~/Scripts/Affiliate/EditAffiliate.js"></script>
    <script type="text/javascript">
        var viewResources = {
            Error_Require_AssignedDomain: '@ViewResources.Error_Require_AssignedDomain',
            Error_Require_OddType: '@ViewResources.Error_Require_OddType',
            Error_Require_Language: '@ViewResources.Error_Require_Language',
            Error_Require_Sport: '@ViewResources.Error_Require_Sport',
            Error_Require_Country: '@ViewResources.Error_Require_Country',
            Error_Require_Market: '@ViewResources.Error_Require_Market',
            Error_Require_League: '@ViewResources.Error_Require_League',
            Error_Require_Outright: '@ViewResources.Error_Require_Outright',
            Error_Require_NumberOfIPs: '@ViewResources.Error_Require_NumberOfIPs',
            Error_NumberOfIPs: '@ViewResources.Error_NumberOfIPs',
            MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'             
        };
    </script>
}
<div class="infor">
    <span class="infor-ic">&nbsp;</span><span class="infor-text">The wizard will help you
        to create a new affiliate in your licensee system.</span></div>
<div class="newline">
    &nbsp;</div>
<div class="result-message-box hidden">
</div>
<div class="step-reg">
    <div id="panelStep1" class="step-active">
        <span class="firstLetter">1</span><span class="normal">Affiliate Information<br />
            Settings</span></div>
    <div id="panelStep2" class="step-inactive">
        <span class="firstLetter">2</span><span class="normal">Authentication<br />
            Settings</span></div>
    <div id="panelStep3" class="step-inactive">
        <span class="firstLetter">3</span><span class="normal">Odds Profile<br />
            Settings</span></div>
    <div id="panelStep4" class="step-inactive">
        <span class="firstLetter">4</span><span class="normal">Completed<br />
            &nbsp;</span></div>
</div>
<div class="newline">
    &nbsp;</div>
    @using (Html.BeginForm("Home", "Index", FormMethod.Post, new { id = "formAffiliate" }))
    {
<div id="step1" class="step">
    <h2>
        Step 1: Affiliate Information Settings</h2>
    <h3>
        @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
    <div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
        <ul>
            <li id="nameReqErr" style="display: none">@ViewResources.Error_NameRequired</li>
            <li id="nameInvalidErr" style="display: none">@ViewResources.Error_NameContent</li>
            <li id="nameLengErr" style="display: none">@ViewResources.Error_NameLength</li>
            <li id="emailReqErr" style="display: none">@ViewResources.Error_EmailRequired</li>
            <li id="emailInvalidErr" style="display: none">@ViewResources.Error_EmailContent</li>
            <li id="websiteReqErr" style="display: none">@ViewResources.Error_WebsiteRequired</li>
            <li id="websiteInvalidErr" style="display: none">@ViewResources.Error_WebsiteContent</li>
            <li id="nameExistedErr" style="display: none">@ViewResources.Error_Exist_AffiliateName</li>
        </ul>
    </div>
    <div class="newline">
        &nbsp;</div>
    <div class="form">
        <div class="row">
            <div class="grid2">
                <label for="id1">
                    @ViewResources.Name</label></div>
            <div class="grid5">
                <input type="text" id="txtName" maxlength="50" />
            </div>
            <div class="gird1">
                <span style="padding-left: 120px" class="red">(*)</span>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                <label for="id1">
                    @ViewResources.Email</label></div>
            <div class="grid5">
                <input type="text" id="txtEmail" maxlength="50" /></div>
            <div class="gird1">
                <span style="padding-left: 120px" class="red">(*)</span>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                <label for="id1">
                    @ViewResources.Website</label></div>
            <div class="grid5">
                <input type="text" id="txtWebsite" maxlength="200" /></div>
            <div class="gird1">
                <span style="padding-left: 120px" class="red">(*)</span>
            </div>
        </div>
        <div class="row2">
            <div class="grid2">
                <label for="id2">
                    @ViewResources.Note</label></div>
            <div class="grid5">
                <textarea id="txtNote"></textarea></div>
        </div>
        <div class="row2 hidden">
            <div class="grid2">
                <label for="id2">
                    @ViewResources.Request_mail_content</label></div>
            <div class="grid5">
                <textarea id="txtContent"></textarea></div>
        </div>
        <div class="row">
            <div class="grid2">
            </div>
            <div class="grid2">
                <input id="step1Cancel" type="button" value="Cancel" class="cancel" />
            </div>
            <div class="grid2">
                <input id="step1Next" type="button" value="Next" />
            </div>
        </div>
    </div>
</div>
<div id="step2" class="step hide">
    <h2>
        Step 2: Authentication Settings</h2>
    <h3>
        Each affiliate can only access our XML Odds Feeds data under allowed domains and
        IPs
    </h3>
    <h3>
        @Html.Raw(ViewResources.HtmlTemplate_InputRequired)</h3>        
    <h3 id="errorStep2_NumberOfIPs">
        Maximum number of IPs = @ViewBag.NumberOfIPs</h3>
    <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">
    </div>
    <div class="form2 formAssignDomainSetting">
        <input type="hidden" id="numberOfIPs" value="@ViewBag.NumberOfIPs" />
        <div class="row3">
            <div class="grid2" style="line-height: 150px; text-align: center">
                <label for="id1">
                    @ViewResources.Domains</label></div>
            <div class="grid9" style="height: 220px; border-style: solid; border-width: 1px;
                border-color: #C8C8C8">
                <div class="grid6" style="width: 305px">
                    <div class="row">
                        @Html.Label(ViewResources.DomainList)
                    </div>
                    <div class="row2">
                        <div class="grid4" style="overflow: auto; border: thin none; height: 155px; width: 300px;">
                            @Html.ListBox("slDomain", null, new { size = 8 })
                        </div>
                    </div>
                    <div class="row">
                        <div class="grid4" style="text-align: left;">
                            @Html.Label("leftShowing", ViewResources.Showing, new { id = "showingDomainListId" })
                        </div>
                    </div>
                </div>
                <div class="grid2">
                    <div class="row">
                    </div>
                    <!--[if ie]>
                        <div id="ieOnly">
                    <![endif]-->
                    <div class="row btndomain" style="margin-top: 15px;">
                        <span id="btnRight" class="arrow right"></span>
                        <br />
                        <span id="btnDoubleRight" class="arrow doubleright"></span>
                        <br />
                        <span id="btnLeft" class="arrow left"></span>
                        <br />
                        <span id="btnDoubleLeft" class="arrow doubleleft"></span>
                    </div>
                    <!--[if ie]>
                    </div>
                    <![endif]-->
                </div>
                <div class="grid6" style="width: 305px">
                    <div class="row">
                        @Html.Label(ViewResources.AssignedDomains)
                    </div>
                    <div class="row2">
                        <div class="grid4" style="overflow: auto; border: thin none; height: 155px; width: 300px;">
                            @Html.ListBox("slAssignedDomain", null, new { size = 8 })
                        </div>
                    </div>
                    <div class="row">
                        <div class="grid4" style="text-align: left;">
                            @Html.Label("rightShowing", ViewResources.Showing, new { id = "showingAssignedDomainId" })
                        </div>
                    </div>
                </div>
                <div class="grid1" style="line-height: 150px; text-align: left">
                    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>
        </div>
        <div id="IpDiv" class="row2" style="margin-top: 20px;">
            <div class="grid2" style="line-height: 70px; text-align: center">
                <label for="id2">
                    @ViewResources.IP</label></div>
            <div class="grid8"  style="width:700px">
                <table id="IpTable" style="width: 100%">
                    <thead>
                        <tr>
                            <th style="width: 40%">
                                <label style="text-align: center">
                                    @ViewResources.IPFrom</label>
                            </th>
                            <th style="width: 40%">
                                <label style="text-align: center">
                                    @ViewResources.IPTo</label>
                            </th>
                            <th style="width: 12%">
                                <label style="text-align: center">
                                    @ViewResources.Action</label>
                                <span id="addNewIP" title="Add" class="action addnew"></span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <input name="IP" type="text" />
                            </td>
                            <td>
                                <input name="IP" type="text" />
                            </td>
                            <td>
                                <span style="padding-left: 30px"></span><span title="Delete" class="action del" onclick="removeRowTemporary(this);">
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
            </div>
            <div class="grid2">
                <input id="step2Cancel" type="button" value="Cancel" class="cancel" />
            </div>
            <div class="grid2">
                <input id="step2Previous" type="button" value="Previous" />
            </div>
            <div class="grid2">
                <input id="step2Next" type="button" value="Next" />
            </div>
        </div>
    </div>
</div>
<div id="step3" class="step hide">
    <h2>
        Step 3: Odds Profile Settings</h2>
    <h3>
        Odds profile will show which data (sports, markets, ...) affiliate should have in
        xml stream.</h3>
    <h3>
        @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
    <div id="errorStep3" class="hidden validation-summary-errors" data-valmsg-summary="true">
    </div>
    <div class="form2" style="width: auto;">
        <input type="hidden" id="oddsTypeFlag" value="@ViewBag.OddsTypeFlag" />
        <input type="hidden" id="oddsStyleFlag" value="@ViewBag.OddsStyleFlag" />
        <input type="hidden" id="languagesFlag" value="@ViewBag.LanguagesFlag" />
        <input type="hidden" id="sportsFlag" value="@ViewBag.SportsFlag" />
        <input type="hidden" id="countriesFlag" value="@ViewBag.CountriesFlag" />
        <input type="hidden" id="marketsFlag" value="@ViewBag.MarketsFlag" />       
        <input type="hidden" id="isAccountManagerPermission" value="@ViewBag.HasAccountManagerPermission" />
        <input type="hidden" id="virutalPath" value="@ViewBag.VirtualPath" />    
        <div class="row">
            <div class="grid4" style="text-align: right">
                <label for="OddsType">
                    @ViewResources.OddsType</label></div>
                    @Html.CheckBoxListFor(m => m.OddsType, ViewBag.OddsTypeList as IEnumerable<SelectListItem>, new { @Class = "oddstype", @isDisabled = @ViewBag.OddsTypeFlag ? "" : "disabled" })            
            <div class="grid1" style="float: none;">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row">
            <div class="grid4" style="text-align: right">
                <label for="id1">
                    @ViewResources.OddsStyle</label></div>
                    @Html.DropDownListFor(m => m.OddsRegion, ViewBag.OddsStyleList as IEnumerable<SelectListItem>, new { @id = "slOddsStyle", @isDisabled = @ViewBag.OddsStyleFlag ? "" : "disabled" })            
        </div>
        @if (ViewBag.HasAccountManagerPermission == true)
        {
            <div class="row">
                <div class="grid4" style="text-align: right">
                    @Html.LabelFor(m => m.DelayTimes, "Delay Time")
                </div>
                @Html.LabelFor(m => m.DeadballDelayTimes, "Deadball", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.DeadballDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                @Html.LabelFor(m => m.LiveDelayTimes, "Live", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.LiveDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                @Html.LabelFor(m => m.OutrightDelayTimes, "Outright", new { @class = "font-normal" })
                @Html.DropDownListFor(m => m.OutrightDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
            </div>
            <div class="row">
                    <div class="grid4" style="text-align: right">
                        @Html.LabelFor(m => m.NumberOfIPs, "Number of IPs")
                    </div>
                    @Html.TextBoxFor(m => m.NumberOfIPs, new { @style = "width: 50px", @min = 0 })
                    <div class="grid1" style="float: none;">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                </div>
            </div>             
        }
        <div class="row">
            <div class="grid4" style="text-align: right">
                <label for="id1">
                    @ViewResources.Languages</label></div>
                    @Html.CheckBoxListFor(m => m.LanguageList, ViewBag.LanguageIDList as IEnumerable<SelectListItem>, new { @Class = "language", @isDisabled = @ViewBag.LanguagesFlag ? "" : "disabled" })            
            <div class="grid1" style="float: none;">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row3">
            @Html.HiddenFor(m => m.SportIDList)

            <div class="grid4" style="line-height: 170px; text-align: right">
                <label for="chkAllMajorSports">
                    @ViewResources.MajorSports
                    <input class="hidden" type="checkbox" id="chkAllMajorSports" isdisabled=@(ViewBag.SportsFlag ? "" : "disabled") />
                </label>
            </div>
            <div class="grid7" style="line-height: 170px; text-align: left">
                <label class="font-normal">
                    @Html.CheckBoxListFor(m => m.SportIDList, ViewBag.MajorSportList as IEnumerable<SelectListItem>, new { @Class = "chkMajorSport", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" }, false)
                </label>
            </div>
            @{ 
                var minorSports = ViewBag.MinorSportList as IEnumerable<SelectListItem>;
            }
            <div class="grid4" style="line-height: 170px; text-align: right">
                <label for="chkAllSports">
                    @ViewResources.MinorSports
                </label><input type="checkbox" id="chkAllMinorSports" isdisabled=@(ViewBag.SportsFlag && minorSports.Any() ? "" : "disabled") />
            </div>
            <div class="grid7">
                <div class="checkbox-filter">
                    <label>Search </label>
                    <input id="minorSport-filter" />
                </div>
                <div class="grid7 checkbox-list">
                    @Html.CheckBoxDropDownListFor(m => m.SportIDList, ViewBag.MinorSportList as IEnumerable<SelectListItem>, new { @Class = "chkMinorSport", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" }, false)
                </div>
            </div>
            <div class="grid1" style="line-height: 150px; text-align: left">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row3">
            <div class="grid4" style="line-height: 170px; text-align: right">
                <label for="chkAllCountries">
                    @ViewResources.Countries</label><input type="checkbox" id="chkAllCountries" isdisabled = @(ViewBag.CountriesFlag ? "" : "disabled")   />
            </div>
            <div class="grid7">
                <div class="checkbox-filter">
                    <label>Search </label>
                    <input id="country-filter" />
                </div>
                <div class="grid7 checkbox-list">
                    @Html.CheckBoxDropDownListFor(m => m.CountryCodeList, (IEnumerable<SelectListItem>)ViewBag.CountriesList, new { @class = "chkCountry", @isDisabled = @ViewBag.CountriesFlag ? "" : "disabled"}, false)
                    @Html.HiddenFor(m => m.CountryCodeList)
                </div>
            </div>
            <div class="grid1" style="line-height: 170px;">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        @if (ViewBag.HasAccountManagerPermission == true)
        {
          <div id="League" class="row3">
                @Html.Partial("_LeaguePartialView", new Fanex.OddsFeed.Core.Criteria.Licensee.GetLeagueCriteria()
           {
               SportIDList = Model.SportIDList,
               LeagueIDList = Model.LeagueIDList,
               CountryCodeList = Model.CountryCodeList,
               LeagueKeyword = Model.LeagueKeyword,
               ViewBagLeagueList = ViewBag.LeagueList
           })
            </div>
            <div id="Outrights" class="row3" style="max-height: 210px">
                @Html.Partial("_OutrightPartialView", new Fanex.OddsFeed.Core.Criteria.Licensee.GetOutRightCriteria()
           {
               SportIDList = Model.SportIDList,
               OutRightIDList = Model.OutRightIDList,
               CountryCodeList = Model.CountryCodeList,
               LeagueKeyword_O = Model.LeagueKeyword_O,
               ViewBagOutrightList = ViewBag.OutrightList
           })
            </div>
        }
    <div id="Market" class="row3">
        @{
            var minorMarkets = ViewBag.MinorBettypesList as IEnumerable<SelectListItem>;
            var majorMarkets = (ViewBag.MajorBettypesList as IEnumerable<SelectListItem>);
        }
        <div class="grid4" style="line-height: 170px; text-align: right">
            <label for="chkAllMajorMarkets">
                @ViewResources.MajorMarkets
            </label><input type="checkbox" id="chkAllMajorMarkets" isdisabled=@(ViewBag.MarketsFlag && majorMarkets.Any() ? "" : "disabled") />
        </div>
        <div class="grid7">
            <div class="checkbox-filter">
                <label>Search </label>
                <input id="majormarket-filter" />
            </div>
            <div class="grid7 checkbox-list">
                @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList, majorMarkets, new { @Class = "chkMajorMarket", @isDisabled = @ViewBag.MarketsFlag ? "" : "disabled" }, false)
            </div>
        </div>
        <div class="grid4" style="line-height: 170px; text-align: right">
            <label for="chkAllMinorMarkets">
                @ViewResources.MinorMarkets
            </label><input type="checkbox" id="chkAllMinorMarkets" isdisabled=@(ViewBag.MarketsFlag && minorMarkets.Any() ? "" : "disabled") />
        </div>
        <div class="grid7">
            <div class="checkbox-filter">
                <label>Search </label>
                <input id="minorMarket-filter" />
            </div>
            <div class="grid7 checkbox-list">
                @Html.CheckBoxDropDownListFor(m => m.BetTypeIDList, minorMarkets, new { @Class = "chkMinorMarket", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" }, false)
            </div>
        </div>
        <div class="grid1" style="line-height: 150px; text-align: left">
            @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
        </div>
    </div>
        <div class="row">
            <div class="grid4">
            </div>
            <div class="grid2">
                <input id="step3Cancel" type="button" value="Cancel" class="cancel" />
            </div>
            <div class="grid2">
                <input id="step3Previous" type="button" value="Previous" />
            </div>
            <div class="grid2">
                <input id="step3Next" type="button" value="Next" />
            </div>
        </div>
    </div>
</div>
<div id="step4" class="step hide">
    <h2>
        Step 4: Completed</h2>
    <h3>
        Congratulation! You are done. Please inform URLs below to your affiliate:</h3>
    <div class="form2" style="width: auto; height: 100%">
        <div id="doneId" style="text-align: left;">
        </div>
        <div class="newline">
            &nbsp;</div>
        <div class="row">
            <div class="grid2">
                <input id="step4Previous" type="button" value="Previous" />
            </div>
            <div class="grid2">
                <input id="step4Done" type="button" value="Done" />
            </div>
        </div>
    </div>
</div>
}
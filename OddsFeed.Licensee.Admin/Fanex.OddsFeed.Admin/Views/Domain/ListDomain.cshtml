@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@using System.Web.Optimization
@model Fanex.OddsFeed.Core.Criteria.Domain.GetDomainByPageCriteria
@{
    ViewBag.Title = "Domain List";
    ViewBag.Nav = base.ViewBag.NavigationHome +
                         "<span class='step'>" + ViewBag.Title + "</span>";
}
@section Breadcrumb {
    @Html.Raw(ViewBag.Nav)
}
@section Styles
{
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Fanex.Grid/Fanex.GridCss")" />
    <link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Functions/ListDomain/ListDomainCss")" />
}
@section Scripts
{
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Fanex.Grid/Fanex.GridJs")"></script>
    <script src="@BundleTable.Bundles.ResolveBundleUrl("~/Scripts/Functions/ListDomain/ListDomainJs")"></script>
    <script type="text/javascript">
        var viewResources = {
            ActionResult_Success_AddDomain: '@ViewResources.ActionResult_Success_AddDomain',
            ActionResult_Success_UpdateDomain: '@ViewResources.ActionResult_Success_UpdateDomain',
            ActionResult_Success_DeleteDomain: '@ViewResources.ActionResult_Success_DeleteDomain',
            Domain_Name: '@ViewResources.Domain_Name'
        };
    </script>
}
<div class="infor">
    <span class="infor-ic">&nbsp;</span><span class="infor-text">The list of xml odds feed domains.</span>
</div>
<div class="newline">
    &nbsp;
</div>
<div id="success-message-box" class="success-message-box hidden">
</div>
<div class="listdomain-result-message-box hidden">
</div>
<div>
    <form id="myForm" method="get" action="/request/dailyview">
        @Html.HiddenFor(s => s.PageSize)
        @Html.HiddenFor(s => s.PageIndex)
        @Html.HiddenFor(s => s.PageCount)
        <div class="container_24 bunhat">
            <div class="grid_3 gridlabel">
                @Html.LabelFor(s => s.DomainName, "Domain Name")
                @Html.HiddenFor(s => s.DomainId)
            </div>
            <div class="grid_8">
                @Html.TextBoxFor(s => s.DomainName, new { @onkeyup = "StartAutoSuggesttion()" })
            </div>
            <div class="grid_2">
                <input type="button" value="Search" onclick="Submit()">
            </div>
            <div class="grid_2">
                <input type="button" id="AddDomain" value="Add Domain" style="width: auto;" onclick="btnAddDomainClick();" />
            </div>
        </div>
    </form>
</div>
<div class="newline">
    &nbsp;
</div>
<div id="SearchResult" class="freegrid  content-grid">
</div>
<br />
<div id="DomainDetail" class="freegrid  content-grid hidden">
</div>
<div id="dialog-form" title="Create Domain" style="display: none">
    @Html.Partial("DomainCreate")
</div>
<div id="dialog-form-update" title="Update Domain" style="display: none">
    @Html.Partial("DomainEdit")
</div>
<div id="dialog-form-delete" title="LICENSEE ADMIN" style="display: none">
    @Html.Partial("DomainDelete")
</div>
        public string GetAllLicenseeRequest(LicenseeRequestCriteria criteria)
        {
            try
            {                
                criteria.PageIndex++;

                JavaScriptSerializer serializer = new JavaScriptSerializer();
                var dr = _licenseeService.GetAllLicenseeRequestReturnDataCollection(criteria);

                return FanexGridHelper.DataForFanexGrid(dr);
            }
            catch (Exception ex)
            {
                LogService.Error(ex.Message, ex);
                throw ex;
            }
        }

        public string GetLicenseeRequestsDetail(RequestStatisticCriteria _criteria, string date, int year)
        {
            try
            {
                DateTime dateStart = new DateTime();
                DateTime dateEnd = new DateTime();

                switch (_criteria.PeriodOption.ToString())
                {
                    case "Week":
                        DateTime dt = new DateTime(year, 1, 1).AddDays((int.Parse(date) - 1) * 7 - (int.Parse(date) == 1 ? 0 : 1));
                        dt = dt.AddDays(-(int)dt.DayOfWeek);

                        dateStart = dt.AddDays(1);
                        dateEnd = dt.AddDays(7);

                        break;
                    case "Year":
                        dateStart = DateTime.Parse(date);
                        dateEnd =  DateTime.Parse(date).AddMonths(1).AddDays(-1); //get last day of month
                        break;

                    default:
                        dateStart = DateTime.Parse(date);
                        dateEnd = DateTime.Parse(date);
                        break;
                }

                var criteria = new RequestStatisticCriteria()
                {
                    SystemId = _criteria.SystemId,
                    DateStart = dateStart,
                    DateEnd = dateEnd,
                    PageSize  = _criteria.PageSize,
                    PageIndex = _criteria.PageIndex

                };
               
                criteria.PageIndex++;

                JavaScriptSerializer serializer = new JavaScriptSerializer();
                var dr = _affiliateService.GetPartnerRequestStatisticReturnDataCollection(criteria);

                return FanexGridHelper.DataForFanexGrid(dr);
            }
            catch (Exception ex)
            {
                LogService.Error(ex.Message, ex);
                throw ex;
            }
        }        
    }
}
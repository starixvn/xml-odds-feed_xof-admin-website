        #region Update Password
        [HttpGet]
        public ActionResult UpdateUserPassword()
        {
            ModelState.Clear();
            var criteria = new UpdatePasswordUserCriteria();
            criteria.UserID = _currentSession.UserId;
            return View(criteria);
        }

        [HttpPost]
        public ActionResult UpdateUserPasswordPost(UpdatePasswordUserCriteria criteria)
        {
            if (ModelState.IsValid)
            {
                criteria.OldPassword = Cryptography.CfsEnCode(criteria.OldPassword);
                criteria.Password = Cryptography.CfsEnCode(criteria.Password);
                criteria.ConfirmPassword = Cryptography.CfsEnCode(criteria.ConfirmPassword);
                var result = _service.UpdateData(criteria);
                if (result.Code == 0)
                {
                    return RedirectToAction("Index", "Home", new { systemId = _currentSession.SystemId });
                }
                else
                { 
                    ModelState.AddModelError("Error", GetMessage(result.Code));
                }
            }

            return View("UpdateUserPassword");
        }
        #endregion
    }

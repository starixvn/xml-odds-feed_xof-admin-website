    [IsUnderMaintainance]
    [SuppressMessage("Microsoft.StyleCop.CSharp.DocumentationRules", "SA1600:ElementsMustBeDocumented")]
    public class LoginController : BaseController
    {
        #region members

        private IUserService _userService;        
        private ICurrentSession _currentSession;
        private IBaseService _service;
        private Fanex.NAP.Core.Service.Interface.IMaintainanceService _maintenanceService;
        #endregion

        #region ctors

        public LoginController()
            : this(null, null)
        {
        }

        public LoginController(
            IUserService userService,            
            ICurrentSession currentSession)
        {
            _userService = userService ?? new UserService();            
            _currentSession = currentSession ?? new CurrentSession();
            _service = _service ?? new BaseService();
            _maintenanceService = new Fanex.NAP.Core.Service.Impl.MaintainanceService();
        }

        #endregion

        #region helpers   

        private void CreateAuthInfo(User user)
        {
            var authInfo = new AuthInfo();

            authInfo.UserId = user.Id;
            authInfo.OnUserId = this._currentSession.OnUserId;

            var authTicket = new FormsAuthenticationTicket(
                 1,
                user.Username,
                DateTime.Now,
                DateTime.Now.AddMinutes(20000),
                false,
                authInfo.ToXml(),
                FormsAuthentication.FormsCookiePath);

            string encryptedTicket = FormsAuthentication.Encrypt(authTicket);
            var authCookie = new HttpCookie(FormsAuthentication.FormsCookieName, encryptedTicket)
            {
                HttpOnly = true,
                Path = FormsAuthentication.FormsCookiePath,
                Name = FormsAuthentication.FormsCookieName
            };

            Response.Cookies.Add(authCookie);
        }

        #endregion

        #region sign in

        public LoginCaptcha ShowCaptchaImage()
        {
            return new LoginCaptcha();
        }

        [HttpGet]
        public ActionResult Index()
        {
            var maintenanceInfo = _maintenanceService.GetDowntimeInfo();

            if (maintenanceInfo.IsDowntime)
            {
                return RedirectToAction("UnderMaintainance", "Tolerance", new { timeFrom = maintenanceInfo.From, timeTo = maintenanceInfo.To });
            }

            return View();
        }

        [HttpPost]
        //public ActionResult Index(string username, string password, string validate)
        public ActionResult Index(UserLoginUserCriteria criteria)
        {
            string username = criteria.UserName;
            string password = criteria.UserPwd;
            string validate = criteria.Validate;

            if (validate != HttpContext.Session["captchastring"].ToString())
            {
                ViewBag.Message = "Invalid validation code!";
                return View();
            }
            if (!username.IsNullOrTrimEmpty() && !password.IsNullOrTrimEmpty())
            {
                try
                {
                    //var domain = new Uri(HttpContext.Request.Url.AbsoluteUri).GetLeftPart(UriPartial.Authority).Replace("www", "");
                    //string loginIp = (Dns.GetHostEntry(Dns.GetHostName()).AddressList.FirstOrDefault(ip => ip.AddressFamily == AddressFamily.InterNetwork) ?? new IPAddress(new byte[] { 127, 0, 0, 1 })).ToString();

                    password = Cryptography.CfsEnCode(password);

                    criteria.UserPwd = password;
                    criteria.LoginDomain = CurrentContext.DomainName;
                    criteria.LoginIP = CurrentContext.IP;
                    criteria.NetSessionID = Session.SessionID;
                    criteria.LoginDate = DateTime.Now;
                    criteria.BrowserName = CurrentContext.BrowserName;
                    criteria.CountryCode = CurrentContext.CountryCode;
                    criteria.Domain = CurrentContext.DomainName;
                    criteria.Platform = CurrentContext.Platform;

                    var user = _userService.UserLogin(ref criteria) as User ;

                    if (user != null)
                    {
                        if (criteria.ErrCode == 100)
                        {
                            ViewBag.Message = criteria.ErrMsg; // ViewResources.Invalid_Username_or_Password;
                        }
                        else if (criteria.ErrCode == 101)
                        {
                            ViewBag.Message = ViewResources.Invalid_Username_or_Password;
                        }
                        else if (criteria.ErrCode == 102)
                        {
                            ViewBag.Message = ViewResources.This_user_is_not_active;
                        }
                        else if (criteria.ErrCode == 103)
                        {
                            ViewBag.Message = ViewResources.This_user_has_no_permission;
                        }
                        else if (criteria.ErrCode == 104)
                        {
                            ViewBag.Message = ViewResources.This_user_are_not_authorized_to_use_this_system;
                        }
                        else //login successfully
                        {                   
                            //get systemId
                            string[] systemIdNameList = criteria.SystemIdNameList.Split(';');
                            string[] firstSystem = systemIdNameList[0] !=null ? systemIdNameList[0].Split(',') : null;
                            byte systemId = firstSystem != null & !string.IsNullOrEmpty(firstSystem[0]) ? Convert.ToByte(firstSystem[0]) : Convert.ToByte(0);

                            var criteriaProfile = new UserGetProfileCriteria
                            {                        
                                UserId = user.Id,                                
                                SystemId  = systemId,
                                IP = CurrentContext.IP,
                                NetSessionID = Session.SessionID                                                
                            };
                             var flags = _userService.UserGetProfile(ref criteriaProfile);

                            #region saves user session
                            
                            _currentSession.UserId = user.Id;
                            _currentSession.UserRole = user.RoleID;
                            _currentSession.Username = username;
                            _currentSession.OnUserId = criteriaProfile.OnUserId;
                            _currentSession.SystemId = systemId;
                            _currentSession.SystemList = criteria.SystemIdNameList;

                            _currentSession.PermissionFlags.NumberOfIPs = flags.NumberOfIPs;
                            _currentSession.PermissionFlags.OddsTypeFlag = flags.OddsTypeFlag;
                            _currentSession.PermissionFlags.OddsStyleFlag = flags.OddsStyleFlag;
                            _currentSession.PermissionFlags.LanguageListFlag = flags.LanguageListFlag;
                            _currentSession.PermissionFlags.SportIDListFlag = flags.SportIDListFlag;
                            _currentSession.PermissionFlags.CountryCodeListFlag = flags.CountryCodeListFlag;
                            _currentSession.PermissionFlags.BetTypeIDListFlag = flags.BetTypeIDListFlag;

                            _currentSession.SessionId = Session.SessionID.ToString();
                                                                                    
                            CreateAuthInfo(user);
                            #endregion

                            return RedirectToAction("List", "Affiliate", new { systemId = _currentSession.SystemId });
                        }
                    }
                }
                catch (Exception ex)
                {
                    LogService.Error(ex.Message, ex);
                    throw ex;
                }                
            }
            else
            {
                ViewBag.Message = "Invalid input!";
            }

            return View();
        }

        #endregion

        #region sign out

        public ActionResult LogOut()
        {
            DoSignOut();
            
            return RedirectToAction("Index");
        }

        private void DoSignOut()
        {
            _userService.UserLogOut(new LogOutUserCriteria
            {
                OnUserId = _currentSession.OnUserId
            });
            FormsAuthentication.SignOut();
            _currentSession.ClearAll();
        }

        #endregion


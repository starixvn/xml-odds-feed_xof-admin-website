@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>LICENSEE ADMIN - Under Maintenance</title>
    <style media="screen" type="text/css">
        body
        {
            margin: 0px 0px;
            padding: 0px;
            text-align: left;
            font-family: Tahoma;
     
        }
        .pageheader
        {
            background: #000000 url("~/css/images/top-bg.png") repeat;
            height: 46px;
            border-top: 1px solid #f5f5f5;
            border-bottom: 1px solid #898989;
            padding-left: 19px;
            padding-right: 15px;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <div class="pageheader">
        <div style="height:100%; margin-top:10px;">
            <img src="~/css/images/logo_licensee.png" alt="" />
        </div>
    </div>
    <div style="text-align: center; margin-top:50px;">
        <div>
            <div>
                <img src="~/css/images/tp_maintenance.png" />
                <br />
            </div>
            <table width="100%">
                <tr align="center">
                    <td align="right"><img src="~/css/images/tp_exclamation.png" /></td>
                    <td align="left" style="width:64%; font-size: 50px; color: #0072bc; vertical-align:middle;">UNDER MAINTENANCE</td>
                </tr>
            </table>
            <br />
            <table width="100%">
                <tr align="center">
                    <td></td>
                    <td align="left" style="width:65%; font-size: 12px; vertical-align:middle;">We are having server maintenance, website will be unavailable until <span class="em">@(ViewBag.UmtTo)</span> (HK Time GMT +8).</td>
                </tr>
                <tr align="center">
                    <td></td>
                    <td align="left" style="width:65%; font-size: 12px; vertical-align:middle;">Sorry for the inconveniences caused!</td>
                </tr>
            </table>
            <br />
            <div>
                <span style="font-size: 12px; color:#0072bc;">
                    <a style="text-decoration:none;" href="@Url.Action("index", "login")">Back to Homepage</a>
                </span>
                <br />
            </div>
        </div>
    </div>
    <footer></footer>
    <script type="text/javascript" src="~/js/Libs/jquery.js"></script>
</body>
</html>
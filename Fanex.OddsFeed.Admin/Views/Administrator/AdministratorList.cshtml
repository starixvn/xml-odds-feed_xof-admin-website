@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Fanex.OddsFeed.Criteria.Administrator.GetAdminCriteria
@{
	ViewBag.IsDashboard = false;
	ViewBag.Title = "Administrator List";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Breadcrumb {
	<a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
	<span class="step">@ViewBag.Title</span>
}
@section Styles
	{
	<link rel="stylesheet" href="~/minify/css/administrator.min.css" asp-append-version="true">
	<link rel="stylesheet" href="~/minify/css/fanexgrid.min.css" asp-append-version="true">
}
@section Scripts
	{
	<environment include="Development">
		<script src="~/js/Administrator/ListAdministrator.js" asp-append-version="true"></script>
		<script src="~/js/Administrator/EditAdministrator.js" asp-append-version="true"></script>
		<script src="~/js/Fanex.Grid/moment.min.js" asp-append-version="true"></script>
		<script src="~/js/Fanex.Grid/numeral.min.js" asp-append-version="true"></script>
		<script src="~/js/Fanex.Grid/Fanex.Grid.js" asp-append-version="true"></script>
		<script src="~/js/Fanex.Grid/Fanex.Pagination.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/minify/js/listadministrator.min.js" asp-append-version="true"></script>
		<script src="~/minify/js/fanexgrid.min.js" asp-append-version="true"></script>
	</environment>
}
<div class="infor">
	<span class="infor-ic">&nbsp;</span><span class="infor-text">The list of administrators.</span>
</div>
<div class="newline">
	&nbsp;
</div>
<div>
	<div class="form680" style="width: auto;">
		<div class="grid2">
			<label for="SystemID">Licensee</label>
		</div>
		<div class="grid4">
			<select asp-items="@ViewBag.SystemList" id="SystemID" name="SystemID" class="width-auto-fit request">
			</select>
		</div>
		<div class="grid1">
			<label for="isActive">Active</label>
		</div>
		<div class="grid4">
			<select id="isActive" name="isActive" class="width-auto-fit request">
				<option value="" selected>All</option>
				<option value="1">Active</option>
				<option value="0">Inactive</option>
			</select>
		</div>
		<div class="grid1">
			<label for="RoleID">Role</label>
		</div>
		<div class="grid4">
			<select asp-items="@ViewBag.RoleList" id="RoleID" name="RoleID" class="width-auto-fit request">
			</select>
		</div>
		<div class="grid2">
			<label for="Username">Username</label>
		</div>
		<input type="hidden" asp-for="PageSize" />
		<input type="hidden" asp-for="PageIndex" />
		<input type="hidden" asp-for="PageCount" />
		<input asp-for="Username" style="width:200px" maxlength="50" onkeyup="StartAutoSuggesttion()" placeholder="Username" />
		<input type="button" value="Search" onclick="_pageIndex = 0;_pageSize = 10;Search();" />
	</div>
</div>
<div class="newline">
	&nbsp;
</div>
<div id="SearchResult" class="freegrid content-grid">
</div>

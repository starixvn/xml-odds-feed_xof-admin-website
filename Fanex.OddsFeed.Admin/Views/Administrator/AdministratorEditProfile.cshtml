@using Fanex.OddsFeed.Resources
@using Microsoft.AspNetCore.Html;
@model Fanex.OddsFeed.Criteria.Administrator.UpdateAdminInfoCriteria
@{
	ViewBag.IsDashboard = false;
	ViewBag.Title = "Edit Administrator Information";

}
@section Breadcrumb {
	<a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
	<a class="step" href="@Url.Action("AdministratorList", "Administrator")">Administrator List</a>
	<span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}
@section Styles
	{
	<link rel="stylesheet" href="~/minify/css/administrator.min.css" asp-append-version="true">
}
@section Scripts
	{
	<environment include="Development">
		<script src="~/js/Administrator/EditAdministrator.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/minify/js/editadministrator.min.js" asp-append-version="true"></script>
	</environment>

	<script type="text/javascript">
		var currentSessionUserId = '@ViewBag.CurrentUserId';
	</script>
}
<div id="editStep1">
	<form>
		@if (ViewBag.HasEditPermission == null || ViewBag.HasEditPermission == true)
		{
			<h3>
				@(new HtmlString(ViewResources.HtmlTemplate_InputRequired))
			</h3>
			<div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
				<ul>
					<li id="emailReqErr" style="display: none">The Email field is required.</li>
					<li id="emailInvalidErr" style="display: none">The Email field is invalid.</li>
				</ul>
			</div>
			<div class="result-message-box hidden">
			</div>
			<div class="form">
				<div class="row">
					<div class="grid2">
						<input type="hidden" asp-for="UserID" id="txtid" />
						<label asp-for="Username"></label>
					</div>
					<div class="grid5">
						<input asp-for="Username" id="txtUsername" />
					</div>
				</div>
				<div class="row">
					<div class="grid2">
						<label asp-for="FirstName">First Name</label>
					</div>
					<div class="grid5">
						<input asp-for="FirstName" id="txtFirstname" />
					</div>
				</div>
				<div class="row">
					<div class="grid2">
						<label asp-for="LastName">Last Name</label>
					</div>
					<div class="grid5">
						<input asp-for="LastName" id="txtLastname" />
					</div>
				</div>
				<div class="row">
					<div class="grid2">
						<label asp-for="Email"></label>
					</div>
					<div class="grid5">
						<input asp-for="Email" id="txtEmail" />
						<div class="gird1">
							<span style="padding-left: 120px" class="red">(*)</span>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="grid2">
						<label asp-for="RoleID">Role</label>
					</div>
					<div class="grid7">
						@if (Model.RoleID == 1)
						{
							<input class="administratorRole" type="radio" asp-for="RoleID" value="1" checked="checked" />
							<span>Account Manager&nbsp;&nbsp;&nbsp;&nbsp;</span>
							<input class="administratorRole" type="radio" asp-for="RoleID" value="2" />
							<span>Licensee</span>
						}
						else if (Model.RoleID == 2)
						{
							<input class="administratorRole" type="radio" asp-for="RoleID" value="1" />
							<span>Account Manager&nbsp;&nbsp;&nbsp;&nbsp;</span>
							<input class="administratorRole" type="radio" asp-for="RoleID" value="2" checked="checked" />
							<span>Licensee</span>
						}
						else
						{
							<span>Licensee Sub-Account</span>
						}
					</div>
				</div>
				<div class="row">
					<div class="grid2">
					</div>
					<div class="grid2">
						<a href="@Url.Action("AdministratorList", "Administrator")" class="button">@ViewResources.Back</a>
					</div>
					<div class="grid2">
						<input id="btnSave" type="button" value="@ViewResources.Save" />
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="error-message-box">
				<ul>
					<li>@ViewBag.Error</li>
				</ul>
			</div>
		}
	</form>
</div>

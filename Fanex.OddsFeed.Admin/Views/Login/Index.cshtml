@model Fanex.OddsFeed.Criteria.User.UserLoginUserCriteria
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <link rel="stylesheet" href="~/minify/css/login.min.css" asp-append-version="true">
</head>
<body>
    <form >
        <div class="lgbox">
            <div class="lgright">
                &nbsp;
            </div>
            <div class="lgcontent">
                <div class="row line">
                    <span class="icadmin">&nbsp;</span>
                    <label class="tit">ADMIN LOGIN</label>
                </div>
                <div id="msg" class="row">
                    <span id="inner-msg">@ViewBag.Message</span>
                </div>
                <div class="row">
                    <div class="grid3">
                        <span class="icuser">&nbsp;</span>
                        <label>USERNAME</label>
                    </div>
                    <div class="grid5">
                        <input asp-for="UserName" class="form-control" id="username" />
                    </div>
                </div>
                <div class="row">
                    <div class="grid3">
                        <span class="icpass">&nbsp;</span>
                        <label>PASSWORD</label>
                    </div>
                    <div class="grid5">
                        <input asp-for="UserPwd" class="form-control" id="password" type="password" />
                    </div>
                </div>
                <div class="row">
                    <div class="grid3">&nbsp;</div>
                    <div class="grid5">
                        <input asp-for="Validate" class="form-control" id="validate" name="validate" style="width: 100px" maxlength="4" />
                        <img id="imgCaptchaId" alt="Validation Code" src="@Url.Action("ShowCaptchaImage", "login")" width="40" height="20" />
                        <span class="icrefresh" id="refreshCaptcha" style="cursor: pointer;" onclick="ChangeCapchaCode('imgCaptchaId');">&nbsp;</span>
                        <span style="margin-left: 40px"></span>
                        <button id="submit" type="button" class="btn btn-primary">Login</button>
                    </div>
                </div>
                <div class="row"></div>
            </div>
        </div>
    </form>
    <script type="text/javascript">
        var currentDomainURL = '@Url.Content("~/")';
    </script>
    <script src="~/js/login/login.js"></script>
    <script src="~/js/Libs/jquery.js"></script>
</body>
</html>

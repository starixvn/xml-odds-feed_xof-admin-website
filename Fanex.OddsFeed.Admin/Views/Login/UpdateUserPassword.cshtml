@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model  Fanex.OddsFeed.Core.Criteria.User.UpdatePasswordUserCriteria
@{
    ViewBag.IsDashboard = false;
    ViewBag.Title = "Update Password";
    string action = ViewBag.RefAction;
    string controller = ViewBag.RefController;
    string linkText = ViewResources.Back;
    string url = Url.Action(action, controller);
}

@section Breadcrumb {
    <a class="step" href="#!">
        Personal
    </a>
    <span class="step">@ViewBag.Title</span>
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/user/updatepassword.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/updatepassword.min.js" asp-append-version="true"></script>
    </environment>
}

@using (Html.BeginForm("UpdateUserPassword", "Login", FormMethod.Post, new { id = "formUpdateUserPassword" }))
{    
    <div class="infor">
        <span class="infor-ic">&nbsp;</span><span class="infor-text">@ViewBag.Title</span></div>
    <h3>
        @Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>    
    <div id="errorUpdatePass" class="validation-summary-errors hidden" data-valmsg-summary="true">
        <ul>
            <li id="oldPassReqErr" style="display: none">@ViewResources.Error_OldPasswordRequired</li>
            <li id="oldPassWhiteSpaceErr" style="display: none">@ViewResources.Error_OldPasswordWhiteSpace</li>
            <li id="oldPassLengErr" style="display: none">@ViewResources.Error_OldPasswordLength</li>
            <li id="newPassReqErr" style="display: none">@ViewResources.Error_NewPasswordRequired</li>
            <li id="newPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationNewPassword</li>
            <li id="newPassLengErr" style="display: none">@ViewResources.Error_NewPasswordLength</li>
            <li id="confirmPassReqErr" style="display: none">@ViewResources.Error_ConfirmPasswordRequired</li>
            <li id="confirmPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationConfirmPassword</li>
            <li id="confirmPassLengErr" style="display: none">@ViewResources.Error_ConfirmPasswordLength</li>
            <li id="pwdNotMatchErr" style="display: none">@ViewResources.Error_PasswordNotMatch</li>
        </ul>
    </div>
     
    <div class="result-message-box hidden">
    </div>
    <div class="newline">
        &nbsp;</div>
    
    <div class="form">
        <div class="row">
            @Html.HiddenFor(a => a.UserID)
            <div class="grid3">
                @Html.LabelFor(a => a.OldPassword, "Old Password")
            </div>
            <div class="grid6">
                @Html.PasswordFor(a => a.OldPassword, new { @autocomplete = "off", style = "width: 90%" })
            </div>
            <div class="gird1">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row">
            <div class="grid3">
                @Html.LabelFor(a => a.Password, "New Password")
            </div>
            <div class="grid6">
                @Html.PasswordFor(a => a.Password, new { @autocomplete = "off", @style = "width: 90%" })
            </div>
            <div class="gird1">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row">
            <div class="grid3">
                @Html.LabelFor(a => a.ConfirmPassword, "Confirm Password")
            </div>
            <div class="grid6">
                @Html.PasswordFor(a => a.ConfirmPassword, new { @autocomplete = "off", style = "width: 90%" })
            </div>
            <div class="grid1">
                @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
            </div>
        </div>
        <div class="row hidden">
            <div class="grid6">
                @Html.EditorFor(a => a.PreController, "", null)
            </div>
            <div class="grid6">
                @Html.EditorFor(a => a.PreAction, "", null)
            </div>
        </div>
        <div class="row">
            <div class="grid3">
            </div>
            <div class="grid2">
                <a href="@url" class="button">@linkText</a>
            </div>
            <div class="grid2">
                <input id="Save" type="button" value="@ViewResources.Save" />
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    var refController = '@ViewBag.RefController';
    var refAction = '@ViewBag.RefAction';
</script>

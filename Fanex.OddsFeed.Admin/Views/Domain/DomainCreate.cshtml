@using Fanex.OddsFeed.Resources
@model Fanex.OddsFeed.Criteria.Domain.CreateDomainCriteria

@using (Html.BeginForm())
{    
    <h3>
        @Html.Raw(ViewResources.HtmlTemplate_InputRequired)</h3>
    <div class="result-message-box hidden">
    </div>
    @Html.ValidationSummary(true)
    <fieldset>
        <div class="editor-label">
            @Html.LabelFor(model => model.DomainName, "Domain Name", null)
            @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.DomainName)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.IP)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.IP)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.ISP)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.ISP)
        </div>
    </fieldset>
}
@model Fanex.OddsFeed.Criteria.Domain.UpdateDomainCriteria

<form>
    <div asp-validation-summary="All"></div>

    <div class="result-message-box hidden">
    </div>
    <fieldset>
        <div class="editor-label">
            <input type="hidden" asp-for="DomainID" />
            <label asp-for="DomainName">Domain Name</label>
        </div>
        <div class="editor-field">
            <input asp-for="DomainName" />
        </div>
        <div class="editor-label">
            <label asp-for="IP">IP</label>
        </div>
        <div class="editor-field">
            <input asp-for="IP" />
        </div>
        <div class="editor-label">
            <label asp-for="ISP">ISP</label>
        </div>
        <div class="editor-field">
            <input asp-for="ISP" />
        </div>
    </fieldset>
</form>
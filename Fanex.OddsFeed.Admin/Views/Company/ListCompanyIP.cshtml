@using Fanex.OddsFeed.Resources
@model Fanex.OddsFeed.Criteria.CompanyIP.InsertCompanyIPsCriteria
@{
    ViewBag.IsDashboard = false;
    ViewBag.Title = "Company IPs";
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <span class="step">@ViewBag.Title</span>
}
@section Styles
    {
    <link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}
@section Scripts
    {
    <environment include="Development">
        <script src="~/js/Functions/CompanyIP/CommonCompanyIP.js" asp-append-version="true"></script>
        <script src="~/js/Functions/CompanyIP/InsertCompanyIP.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/listcompanyip.min.js" asp-append-version="true"></script>
    </environment>
}
<div id="step2" class="step">
    <form id="formCompanyIP">
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">
                The function provide all company's
                IPs then administrators can view XML Odds Feed data of any affiliate.
            </span>
        </div>
        <div class="newline">
            &nbsp;
        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="form2" style="width: auto; padding-left: 0; padding-right: 0;">
            <div class="success" style="display: none; text-align: left">
                The authentication setting has been updated successfully!
            </div>
            <div id="IpDiv" class="row2" style="margin-top: 10px;">
                <div class="grid2" style="line-height: 70px; text-align: center">
                </div>
                <div class="grid8">
                    <table id="IpTable" style="width: 100%">
                        <thead>
                            <tr>
                                <th>
                                    <label style="text-align: center">
                                        @ViewResources.IPFrom
                                    </label>
                                </th>
                                <th>
                                    <label style="text-align: center">
                                        @ViewResources.IPTo
                                    </label>
                                </th>
                                <th>
                                    <label style="text-align: center">
                                        Description
                                    </label>
                                </th>
                                <th>
                                    <label style="text-align: center">
                                        @ViewResources.Action
                                    </label><span title="Add" id="newIP" class="action addnew"></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input name="FromIP" type="text" />
                                </td>
                                <td>
                                    <input name="ToIP" type="text" />
                                </td>
                                <td>
                                    <input name="Description" type="text" />
                                </td>
                                <td>
                                    <span style="padding-left: 25px"></span><span title="Save" class="action save" onclick="SaveIPSetting(this)">
                                    </span><span style="padding-left: 30px"></span><span title="Delete" class="action del"
                                                                       onclick="removeRow(this);"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <input type="hidden" asp-for="ListIPFrom" />
            <input type="hidden" asp-for="ListIPTo" />
            <input type="hidden" asp-for="ListDescription" />
            <div class="row">
                <div class="grid2">
                </div>
                <div class="grid2">
                    <input id="Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="Save" type="button" value="Save" />
                </div>
            </div>
        </div>
    </form>
</div>
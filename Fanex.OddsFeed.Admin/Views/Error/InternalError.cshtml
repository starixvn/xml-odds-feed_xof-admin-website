@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>LICENSEE ADMIN - Internal Error</title>
    <style media="screen" type="text/css">
        body {
            margin: 0px 0px;
            padding: 0px;
            text-align: left;
            font-family: Tahoma;
        }

        .pageheader {
            background: #000000 url("~/css/images/top-bg.png") repeat;
            height: 46px;
            border-top: 1px solid #f5f5f5;
            border-bottom: 1px solid #898989;
            padding-left: 19px;
            padding-right: 15px;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <div class="pageheader">
        <div style="height:100%; margin-top:10px;">
            <img src="~/css/images/logo_licensee.png" alt="" />
        </div>
    </div>
    <div style="text-align: center; margin-top:50px;">
        <div>
            <div>
                <img src="~/css/images/tp_error.jpg" alt="" />
                <br />
            </div>
            <div style="font-size: 50px; color: #0072bc; vertical-align:middle;"> Sorry! The system is not availabe</div>
            <br /><br />
            <div>
                <span style="font-size: 12px;">We are sorry. The system is currently unavailable. Please try again later or contact administrator.</span>
                <br /><br />
            </div>
            <div>
                <span style="font-size: 12px; color:#0072bc;">
                    <a style="text-decoration:none;" href="@Url.Action("ShowDashboard", "Dashboard")">Back to Homepage</a>
                </span>
                <br />
            </div>
        </div>
    </div>
    <footer></footer>
</body>
</html>
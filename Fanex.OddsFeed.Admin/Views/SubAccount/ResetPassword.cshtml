@using Fanex.OddsFeed.Core
@using Fanex.OddsFeed.Resources;
@model Fanex.OddsFeed.Criteria.SubAccount.ResetPassSubAccCriteria
@{
	ViewBag.Title = "Reset password";
	ViewBag.IsDashboard = false;
}

@section Breadcrumb {
	<a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
	<a class="step" href="@Url.Action("List", "SubAccount")">Sub-account List</a>
	<span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}

@section Scripts
	{
	<script src="~/js/SubAccount/EditSubAcc.js" asp-append-version="true"></script>
}

<div id="editStep1">
	<form>
		<div class="result-message-box hidden"></div>
		<div id="errorUpdatePass" class="validation-summary-errors hidden" data-valmsg-summary="true">
			<ul>
				<li id="newPassReqErr" style="display: none">@ViewResources.Error_NewPasswordRequired</li>
				<li id="newPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationNewPassword</li>
				<li id="newPassLengErr" style="display: none">@ViewResources.Error_NewPasswordLength</li>
				<li id="confirmPassReqErr" style="display: none">@ViewResources.Error_ConfirmPasswordRequired</li>
				<li id="confirmPassWhiteSpaceErr" style="display: none">@ViewResources.InvalidFieldValidationConfirmPassword</li>
				<li id="confirmPassLengErr" style="display: none">@ViewResources.Error_ConfirmPasswordLength</li>
				<li id="pwdNotMatchErr" style="display: none">@ViewResources.Error_PasswordNotMatch</li>
			</ul>
		</div>

		<div class="infor">
			<span class="infor-ic"></span><span class="infor-text">@Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</span>
		</div>

		<div class="newline">
			&nbsp;
		</div>

		<div class="form">
			<div class="row">
				<input type="hidden" asp-for="SubAccountID" />
				<div class="grid3">
					<label asp-for="Password"></label>
				</div>
				<div class="grid4">
					<input asp-for="Password" type="password" id="txtPassword" style="width:250px" autocomplete="off" />
				</div>
				<div class="gird1">
					<span style="padding-left: 120px" class="red">(*)</span>
				</div>
			</div>

			<div class="row">
				<div class="grid3">
					<label asp-for="ConfirmPassword">Confirm Password</label>
				</div>
				<div class="grid4">
					<input asp-for="ConfirmPassword" type="password" id="txtConfirmPassword" style="width:250px" autocomplete="off" />
				</div>
				<div class="gird1">
					<span style="padding-left: 120px" class="red">(*)</span>
				</div>
			</div>

			<div class="row">
				<div class="grid3">
				</div>
				<div class="grid2">
					<a href="@Url.Action("list", "subaccount")" class="button">@ViewResources.Cancel</a>
				</div>
				<div class="grid2">
					<input id="Save" class="updatePassword" type="button" value="@ViewResources.Save" />
				</div>
			</div>
		</div>
	</form>
</div>

@{
    ViewBag.Title = "Header";
}
<div class="header_wrap">
    <div class="header">
        <div class="newline">&nbsp;</div>
        <img src="~/css/images/logo_licensee.png" alt="" />
        <div style="text-align: right; margin-top: -32px;">
            <div id="user_utilities" class="dropdown_navigation" style="float: right">
                <h2>@ViewBag.Session.Username</h2>
                <a href="javascript:;" class="dropdown_arrow"></a>
                <ol class="global_navigation">
                    <li>
                        <a class="" href="@Url.Action("UpdateUserPassword", "Login")">Update Password</a>
                    </li>
                    <li><a class="" href="@Url.Action("LogOut", "login")">Log off</a> </li>
                </ol>
            </div>
            <div style='float: right; margin-top: 10px;'>
                <label>Licensee</label>
                @Html.DropDownList("slSystem", ViewBag.SystemList.Result as IEnumerable<SelectListItem>, new { @id = "slSystem" })
                &nbsp;&nbsp;
            </div>
        </div>
    </div>
</div>
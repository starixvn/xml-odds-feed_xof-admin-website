@{
    ViewBag.Title = "NavBar";
}
<div class="column">
    <input type="hidden" id="currentUrl" value="@(ViewBag.Controller.ToString().ToLower() + "_" + ViewBag.Action.ToString().ToLower())" />
    <input type="hidden" id="minDate" value="@ViewBag.Action.ToString().ToLower()" />
    <div class="nav_links">
        <div id="0" class="overview_section togglable_section">
            <div class="separator first">
                <strong>My Profile</strong>
            </div>
        </div>
        <div class="navItem">
            <div data-hashovermenu="False" class="el" id="dashboard_showdashboard">
                <span class="xicon dashboard"></span><a href="~/Dashboard/ShowDashboard">My Dashboard</a>
            </div>
            <div data-hashovermenu="True" class="el" id="affiliate_list">
                <span class="xicon afflist"></span><a href="~/Affiliate/List">Affiliate List</a>
            </div>
            <div data-hashovermenu="True" class="el" id="affiliate_add">
                <span class="xicon addaff"></span><a href="~/Affiliate/Add">Add Affiliate</a>
            </div>
            <div data-hashovermenu="False" class="el" id="affiliate_requests">
                <span class="xicon affstatistic"></span><a href="~/Affiliate/Requests">Affiliate's Statistics</a>
            </div>
            @if (ViewBag.RoleID == 1 || ViewBag.RoleID == 2) //IT admin or Licensee
            {
                <div data-hashovermenu="True" class="el" id="subaccount_list">
                    <span class="xicon subacclst"></span><a href="~/SubAccount/List">Sub-account List</a>
                </div>
                <div data-hashovermenu="True" class="el" id="subaccount_add">
                    <span class="xicon addsubacc"></span><a href="~/SubAccount/Add">Add sub-account</a>
                </div>
            }
        </div>
        @if (ViewBag.RoleID == 1) //IT admin
        {
            <div id="1" class="overview_section togglable_section">
                <div class="separator">
                    <strong>System Configuration</strong>
                </div>
            </div>
            <div class="navItem">
                <div data-hashovermenu="False" class="el" id="administrator_administratorlist">
                    <span class="xicon adminlst"></span><a href="~/Administrator/AdministratorList">
                        Administrator List
                    </a>
                </div>
                <div data-hashovermenu="False" class="el" id="administrator_administratoradd">
                    <span class="xicon addadmin"></span><a href="~/Administrator/AdministratorAdd">
                        Add Administrator
                    </a>
                </div>
                <div data-hashovermenu="False" class="el" id="domain_listdomain">
                    <span class="xicon domain"></span><a href="~/Domain/ListDomain">Domain List</a>
                </div>
                <div data-hashovermenu="False" class="el" id="licensee_listlicensee">
                    <span class="xicon licenseelst"></span><a href="~/Licensee/ListLicensee">
                        Licensee List
                    </a>
                </div>
                <div data-hashovermenu="False" class="el" id="licensee_add">
                    <span class="xicon addlicensee"></span><a href="~/Licensee/Add">Add Licensee</a>
                </div>
                <div data-hashovermenu="False" class="el" id="licensee_requests">
                    <span class="xicon licenseestatistic"></span><a href="~/Licensee/Requests">
                        Licensee's Statistics
                    </a>
                </div>
                <div data-hashovermenu="False" class="el" id="company_listcompanyip">
                    <span class="xicon licenseestatistic"></span><a href="~/Company/ListCompanyIP">
                        Company IPs
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>LICENSEE ADMIN - @ViewBag.Title</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" href="~/minify/css/common.min.css" asp-append-version="true">
    @RenderSection("Styles", false)
</head>

<body class="locale_en production">
    <header>
        @(await Component.InvokeAsync("Header"))
    </header>
    <input type="hidden" id="currentTheme" value="@ViewBag.CurrentTheme" />
    <input type="hidden" id="minDate" value="@ViewBag.MinDate" />
    <input type="hidden" id="maxDate" value="@ViewBag.MaxDate" />
    <div id="container" class="container">
        <nav>
            <div class="column_wrap">
                @(await Component.InvokeAsync("Navbar"))
            </div>
        </nav>
        <section id="section_content">
            <div class="content_wrap">
                @if (ViewBag.IsDashboard == false)
                {
                    <div class="newline">&nbsp;</div>
                    <section id="section_breadcrumb">
                        <div class="separator js-separator">
                            <div class="js-view-title separator-view-title" id="view_title">
                                <div class="breadcrumb">
                                    @RenderSection("Breadcrumb", required: false)
                                </div>
                            </div>
                            <div class="js-menu separator-menu">
                                @RenderSection("SeparatorMenu", required: false)
                            </div>
                        </div>
                    </section>
                    <section id="section_body">
                        <div class="content_scroll">
                            @RenderBody()
                        </div>
                    </section>
                }
                else
                {
                    <section id="section_body">
                        <div class="content_scrolldashboard">
                            @RenderBody()
                        </div>
                    </section>
                }
            </div>
        </section>
        <div class="right_wrap">
        </div>
    </div>
    <footer>
    </footer>
    <div id="message">
    </div>
    <script src="~/minify/js/common.min.js" asp-append-version="true"></script>
    <script type="text/javascript">
        var currentDomainURL = '@Url.Content("~/")';
    </script>
    @RenderSection("Scripts", false)
</body>
</html>

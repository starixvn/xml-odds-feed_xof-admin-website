@using Fanex.OddsFeed.Resources
@using Microsoft.AspNetCore.Html;
@model Fanex.OddsFeed.Criteria.Licensee.GetOutRightCriteria
@{
    ViewBag.OutrightList = Model.ViewBagOutrightList ?? (ViewBag.OutrightList ?? new List<SelectListItem>());
    ViewBag.OutRightIDList = Model.OutRightIDList != null ? Model.OutRightIDList.Split(',') : null;
}
<div class="grid4" style="height: 170px; text-align: right; vertical-align: middle">
    <br />
    <br />
    <br />
    <label asp-for="OutRightIDList" for="chkAllOutrights">Outrights</label>
    <input type="checkbox" id="chkAllOutrights" /><br />
    <label asp-for="LeagueKeyword_O">Keyword</label>
    <input type="text" id="LeagueKeyword_O" name="LeagueKeyword_O" class="keyword-textbox" />
    <br />
</div>
<div class="grid7 checkbox-list">
    @for (var i = 0; i < ViewBag.OutrightList.Count; i++)
    {
        var country = ViewBag.OutrightList[i];
        var id = "OutRightIDList" + country.Value.ToString();

        var isChecked = false;
        if (ViewBag.OutRightIDList != null
        && (Array.IndexOf(ViewBag.OutRightIDList, country.Value.ToString()) > -1 || ViewBag.OutRightIDList[0] == "all"))
        {
            isChecked = true;
        }

        <div style="color: rgb(0, 0, 0);">
            <input @(isChecked ? "checked" : "") class="chkOutright" id="@id" type="checkbox" value="@country.Value">
            <label class="font-normal" for="@id">@country.Text</label>
        </div>
    }
    <input type="hidden" asp-for="OutRightIDList" />
</div>
<div class="grid1" style="line-height: 170px;">
    @(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
</div>

@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.Licensee.GetLeagueCriteria
@{
    ViewBag.LeagueList = Model.ViewBagLeagueList ?? (ViewBag.LeagueList ?? new List<SelectListItem>());
    ViewBag.LeagueIDList = Model.LeagueIDList != null ? Model.LeagueIDList.Split(',') : null;
}
<div class="grid4" style="height: 270px; text-align: right">
    <br />
    <br />
    <br />
    @Html.LabelFor(m => m.LeagueIDList, "Leagues", new { @for = "chkAllLeagues" })
    <input type="checkbox" id="chkAllLeagues" /><br />
    @Html.LabelFor(m => m.LeagueKeyword, "Keyword")
    @Html.TextBoxFor(m => m.LeagueKeyword, new { @Class = "keyword-textbox" })
    <br />
</div>
<div class="grid7">
    <div class="checkbox-filter">
        <label>Search </label>
        <input id="league-filter" />
    </div>
    <div class="grid7 checkbox-list">
        @for (var i = 0; i < ViewBag.LeagueList.Count; i++)
        {
            var country = ViewBag.LeagueList[i];
            var id = "LeagueIDList" + country.Value.ToString();
            var isChecked = false;
            if (ViewBag.LeagueIDList != null
            && (Array.IndexOf(ViewBag.LeagueIDList, country.Value.ToString()) > -1 || ViewBag.LeagueIDList[0] == "all"))
            {
                isChecked = true;
            }

            <div style="color: rgb(0, 0, 0);">
                <input @(isChecked ? "checked" : "") class="chkLeague" id="@id" type="checkbox" value="@country.Value">
                <label class="font-normal" for="@id">@country.Text</label>
            </div>
        }
        
        @Html.HiddenFor(m => m.LeagueIDList)
    </div>
</div>
<div class="grid1" style="line-height: 170px;">
    @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
</div>

@using Fanex.OddsFeed.Resources
@using Fanex.OddsFeed.Models.ValueObject
@using Microsoft.AspNetCore.Html;
@{
    ViewBag.Title = "Edit authentication settings";
    ViewBag.IsDashboard = false;
    var slDomain = ViewData["slDomain"] as List<SelectListItem>;
    var slAssignedDomain = ViewData["slAssignedDomain"] as List<SelectListItem>;
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("List", "Affiliate")">Affiliate List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Affiliate/CommonAffiliate.js" asp-append-version="true"></script>
        <script src="~/js/Affiliate/EditAffiliateStep2.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/editaffiliatesetting.min.js" asp-append-version="true"></script>
    </environment>
    <script type="text/javascript">
        var viewResources = {
            Error_Require_AssignedDomain: '@ViewResources.Error_Require_AssignedDomain',
            ActionResult_UpdateAffiliateInfoSuccess: '@ViewResources.ActionResult_UpdateAffiliateInfoSuccess',
            MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
        };
    </script>
}

<div id="editStep2">
    <div class="infor">
        <span class="infor-ic"></span><span class="infor-text">
            Each affiliate can only access
            our XML Odds Feeds data under allowed domains and IPs.
        </span>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <h3>
        @(new HtmlString(ViewResources.HtmlTemplate_InputRequired))
    </h3>
    <h3 id="errorStep2_NumberOfIPs">
        Maximum number of IPs = @ViewBag.NumberOfIPs
    </h3>
    <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">
    </div>
    <div class="result-message-box hidden">
    </div>
    <div id="success-message-box" class="success success-message-box hidden">
        <ul>
            <li>@ViewResources.ActionResult_UpdateAffiliateInfoSuccess</li>
        </ul>
    </div>
    <div class="form2 formAssignDomainSetting">
        <input type="hidden" id="affID" value="@ViewBag.AffId" />
        <input type="hidden" id="numberOfIPs" value="@ViewBag.NumberOfIPs" />
        <div class="row3">
            <div class="grid2" style="line-height: 150px; text-align: center">
                <label for="id1">
                    @ViewResources.Domains
                </label>
            </div>
            <div class="grid9" style="height: 220px; border-style: solid; border-width: 1px;
                border-color: #C8C8C8">
                <div class="grid6" style="width: 305px">
                    <div class="row">
                        <label>@ViewResources.DomainList</label>
                    </div>
                    <div class="row2">
                        <div class="grid4" style="overflow: auto; border: thin none; height: 155px; width: 300px;">
                            <select id="slDomain" asp-items="slDomain" multiple="multiple" size="8">
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="grid4" style="text-align: left;">
                            <label id="showingDomainListId">Showing</label>
                        </div>
                    </div>
                </div>
                <div class="grid2">
                    <div class="row">
                    </div>
                    <div class="row btndomain" style="margin-top: 15px;">
                        <span id="btnRight" class="arrow right"></span>
                        <br />
                        <span id="btnDoubleRight" class="arrow doubleright"></span>
                        <br />
                        <span id="btnLeft" class="arrow left"></span>
                        <br />
                        <span id="btnDoubleLeft" class="arrow doubleleft"></span>
                    </div>
                </div>
                <div class="grid6" style="width: 305px">
                    <div class="row">
                        <label>Assigned Domains</label>
                    </div>
                    <div class="row2">
                        <div class="grid4" style="overflow: auto; border: thin none; height: 155px; width: 300px;">
                            <select id="slAssignedDomain" asp-items="slAssignedDomain" multiple="multiple" size="8">
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="grid4" style="text-align: left;">
                            <label id="showingAssignedDomainId">Showing</label>
                        </div>
                    </div>
                </div>
                <div class="grid1" style="line-height: 150px; text-align: left">
                    @(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
                </div>
            </div>
        </div>
        <div id="IpDiv" class="row2" style="margin-top: 20px;">
            <div class="grid2" style="line-height: 70px; text-align: center">
                <label for="id2">
                    IP
                </label>
            </div>
            <div class="grid8" style="width:700px">
                <table id="IpTable" style="width: 100%; height: 30px;">
                    <thead>
                        <tr>
                            <th style="width: 40%">
                                <label style="text-align: center">
                                    @ViewResources.IPFrom
                                </label>
                            </th>
                            <th style="width: 40%">
                                <label style="text-align: center">
                                    @ViewResources.IPTo
                                </label>
                            </th>
                            <th style="width: 12%">
                                <label style="text-align: center">
                                    @ViewResources.Action
                                </label>
                                <span id="newIP" title="Add" class="action addnew"></span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.IpList.Count > 0)
                        {
                            foreach (Fanex.OddsFeed.Models.ValueObject.PartnerIP item in ViewBag.IpList)
                            {
                                <tr>
                                    <td>
                                        <input name="IP" type="text" value="@item.IPFrom" />
                                    </td>
                                    <td>
                                        <input name="IP" type="text" value="@item.IPTo" />
                                    </td>
                                    <td>
                                        <span style="padding-left: 25px"></span><span title="Edit" class="action save" onclick="SaveIPSetting(this, '@item.IPFrom',
                                '@item.IPTo')"></span><span style="padding-left: 30px"></span><span title="Delete"
                                                                                                    class="action del" onclick="removeRow(this,'@item.IPFrom','@item.IPTo');"></span>
                                    </td>
                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td>
                                    <input name="IP" type="text" value="" />
                                </td>
                                <td>
                                    <input name="IP" type="text" value="" />
                                </td>
                                <td>
                                    <span style="padding-left: 25px"></span><span title="Save" class="action save" onclick="SaveIPSetting(this, '',
                                '')"></span><span style="padding-left: 30px"></span><span title="Delete" class="action
                            del" onclick="removeRow(this);"></span>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
            </div>
            <div class="grid2">
                <a href="@Url.Action("list", "affiliate")" class="button">@ViewResources.Back</a>
            </div>
            <div class="grid2">
                <input id="editstep2Save" type="submit" value="@ViewResources.Save" />
            </div>
        </div>
    </div>
</div>

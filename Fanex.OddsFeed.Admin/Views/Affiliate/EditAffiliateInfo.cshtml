@using Fanex.OddsFeed.Resources
@using Microsoft.AspNetCore.Html;
@model Fanex.OddsFeed.Criteria.Affiliate.UpdateAffiliateCriteria
@{
    ViewBag.Title = "Edit affiliate information";
    ViewBag.IsDashboard = false;
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("List", "Affiliate")">Affiliate List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}

@section Scripts {
    <environment include="Development">
        <script src="~/js/Affiliate/CommonAffiliate.js" asp-append-version="true"></script>
        <script src="~/js/Affiliate/EditAffiliateInfo.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/editaffiliateinfo.min.js" asp-append-version="true"></script>
    </environment>
    <script type="text/javascript">
        var viewResources = {
            Error_NameRequired: '@ViewResources.Error_NameRequired',
            Error_NameLength: '@ViewResources.Error_NameLength',
            Error_NameContent: '@ViewResources.Error_NameContent',
            Error_EmailRequired: '@ViewResources.Error_EmailRequired',
            Error_EmailContent: '@ViewResources.Error_EmailContent',
            Error_WebsiteRequired: '@ViewResources.Error_WebsiteRequired',
            Error_WebsiteContent: '@ViewResources.Error_WebsiteContent'
        };
    </script>
}

<div id="editStep1">
    <div class="infor">
        <span class="infor-ic"></span><span class="infor-text">@(new HtmlString(ViewResources.HtmlTemplate_InputRequireds))</span>
    </div>
    <div class="newline">
        &nbsp;
    </div>
    <div class="result-message-box hidden">
    </div>

    <div class="form">
        <div class="row">
            <input asp-for="PartnerID" type="hidden" />
            <div class="grid2">
                <label asp-for="UserName"></label>
            </div>
            <div class="grid5">
                <input asp-for="UserName" id="txtUsername" disabled="disabled" />
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                <label asp-for="Email"></label>
            </div>
            <div class="grid5">
                <input asp-for="Email" id="txtEmail" maxlength = "50" />
            </div>
            <div class="gird1">
                <span style="padding-left: 120px" class="red">(*)</span>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
                <label asp-for="Website"></label>
            </div>
            <div class="grid5">
                <input asp-for="Website" id="txtWebsite" maxlength="200" />
            </div>
            <div class="gird1">
                <span style="padding-left: 120px" class="red">(*)</span>
            </div>
        </div>
        <div class="row2">
            <div class="grid2">
                <label asp-for="Note"></label>
            </div>
            <div class="grid5">
                <textarea asp-for="Note" id="txtNote"></textarea>
            </div>
        </div>
        <div class="row">
            <div class="grid2">
            </div>
            <div class="grid2">
                <a href="@Url.Action("list", "affiliate")" class="button">@ViewResources.Back</a>
            </div>
            <div class="grid2">
                <input id="editStep1Save" type="button" value="@ViewResources.Save" />
            </div>
        </div>
    </div>
</div>

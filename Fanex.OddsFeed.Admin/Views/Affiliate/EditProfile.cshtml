@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@using Fanex.OddsFeed.Core.Criteria.Licensee
@model Fanex.OddsFeed.Core.Criteria.Affiliate.UpdateProfileCriteria
@{
    ViewBag.Title = "Edit Affiliate Profile";
    ViewBag.IsDashboard = false;
    var getLeagueCriteria = new GetLeagueCriteria
    {
        SportIDList = Model.SportIDList,
        CountryCodeList = Model.CountryCodeList,
        LeagueIDList = Model.LeagueIDList,
        LeagueKeyword = Model.LeagueKeyword,
        ViewBagLeagueList = ViewBag.LeagueList
    };
    var getOutRightCriteria = new GetOutRightCriteria
    {
        SportIDList = Model.SportIDList,
        CountryCodeList = Model.CountryCodeList,
        OutRightIDList = Model.OutRightIDList,
        LeagueKeyword_O = Model.LeagueKeyword_O,
        ViewBagOutrightList = ViewBag.OutrightList
    };
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("List", "Affiliate")">Affiliate List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentUser</span>
}
@section Styles {
    <link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}
@section Scripts {
    <environment include="Development">
        <script src="~/js/Functions/ListLicensee/CommonLicensee.js" asp-append-version="true"></script>
        <script src="~/js/Affiliate/CommonAffiliate.js" asp-append-version="true"></script>
        <script src="~/js/Affiliate/EditAffiliateStep3.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/editaffiliateprofile.min.js" asp-append-version="true"></script>
    </environment>
    <script type="text/javascript">
        var viewResources = {
            Error_Require_AssignedDomain: '@ViewResources.Error_Require_AssignedDomain',
            Error_Require_OddType: '@ViewResources.Error_Require_OddType',
            Error_Require_Language: '@ViewResources.Error_Require_Language',
            Error_Require_Sport: '@ViewResources.Error_Require_Sport',
            Error_Require_Country: '@ViewResources.Error_Require_Country',
            Error_Require_Market: '@ViewResources.Error_Require_Market',
            Error_Require_League: '@ViewResources.Error_Require_League',
            Error_Require_Outright: '@ViewResources.Error_Require_Outright',
            Error_Require_NumberOfIPs: '@ViewResources.Error_Require_NumberOfIPs',
            Error_NumberOfIPs: '@ViewResources.Error_NumberOfIPs',
            MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
        };
    </script>
}
<div class="newline">&nbsp;</div>
@using (Html.BeginForm("EditProfile", "Affiliate", FormMethod.Post, new { id = "formAffiliate" }))
{
    <div id="editStep3">
        <div class="infor">
            <span class="infor-ic"></span>
            <span class="infor-text">Profile will show which data (sports, markets, results, ...) affiliate should have in xml stream.</span>
        </div>
        <div class="newline">&nbsp;</div>
        <h3>@Html.Raw(ViewResources.HtmlTemplate_InputRequireds)</h3>
        @using (Html.BeginForm())
        {
            if (ViewBag.Success == true)
            {
                <div id="success-message-box" class="success-message-box">
                    <ul>
                        <li>@ViewResources.ActionResult_UpdateAffiliateInfoSuccess</li>
                    </ul>
                </div>
                <input type="hidden" id="successed" value="true" />
            }
            else if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="red">@ViewBag.Error</div>
                <div class="newline">&nbsp;</div>
            }
            <div id="errorStep3" class="hidden validation-summary-errors" data-valmsg-summary="true"></div>
            <div class="result-message-box hidden"></div>
            @Html.ValidationSummary()
            @Html.HiddenFor(m => m.PartnerID)

            <input type="hidden" id="oddsTypeFlag" value="@ViewBag.OddsTypeFlag" />
            <input type="hidden" id="oddsStyleFlag" value="@ViewBag.OddsStyleFlag" />
            <input type="hidden" id="languagesFlag" value="@ViewBag.LanguagesFlag" />
            <input type="hidden" id="sportsFlag" value="@ViewBag.SportsFlag" />
            <input type="hidden" id="countriesFlag" value="@ViewBag.CountriesFlag" />
            <input type="hidden" id="marketsFlag" value="@ViewBag.MarketsFlag" />
            <input type="hidden" id="isAccountManagerPermission" value="@ViewBag.HasAccountManagerPermission" />
            <input type="hidden" id="ActualNumberOfIps" value="@ViewBag.ActualNumberOfIps" />

            <div class="form2" style="width: auto;">
                <div class="row">
                    <div class="grid4" style="text-align: right">
                        <label for="id1">@ViewResources.OddsType</label>
                    </div>
                    @*@Html.CheckBoxListFor(m => m.OddsType,
                        ViewBag.OddsTypeList as IEnumerable<SelectListItem>,
                        new { @Class = "oddstype", @isDisabled = @ViewBag.OddsTypeFlag ? string.Empty : "disabled" },
                        false)*@
                    @for (var i = 0; i < ViewBag.OddsTypeList.Count; i++)
                    {
                        @*var id = "SubGroupArray" + @Model.Teams[i].Id.ToString();
                        var isChecked = Array.IndexOf(@Model.SubGroupArray, @Model.Teams[i].Id.ToString()) > -1;
                        <input checked="@isChecked" class="filled-in SubGroupArray" id="@id" name="SubGroupArray" type="checkbox" value="@Model.Teams[i].Id">
                        <label for="@id">@Model.Teams[i].Name</label>*@
                        var oddsType = ViewBag.OddsTypeList[i];
                        var id = "OddsType" + oddsType.Value.ToString();
                        <label class="font-normal">
                            <input class="oddstype" checked="@oddsType.Selected" id="@id" isdisabled="@oddsType.Disabled" type="checkbox" value="@oddsType.Value">
                            @oddsType.Text
                        </label>
                    }
                    <div class="grid1" style="float: none;">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
                <div class="row">
                    <div class="grid4" style="text-align: right">
                        <label for="id1">@ViewResources.OddsStyle</label>
                    </div>
                    @Html.DropDownListFor(m => m.OddsRegion,
                        ViewBag.OddsStyleList as IEnumerable<SelectListItem>,
                        new { @id = "slOddsStyle", @isDisabled = @ViewBag.OddsStyleFlag ? string.Empty : "disabled" })
                </div>
                @if (ViewBag.HasAccountManagerPermission == true)
                {
                    <div class="row">
                        <div class="grid4" style="text-align: right">
                            @Html.LabelFor(m => m.OddsDelayTimes, ViewResources.OddsDelayTime)
                        </div>
                        <div class="grid7">
                            @Html.LabelFor(m => m.DeadballDelayTimes, ViewResources.Deadball, new { @class = "font-normal" })
                            @Html.DropDownListFor(m => m.DeadballDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                            @Html.LabelFor(m => m.LiveDelayTimes, "Live", new { @class = "font-normal" })
                            @Html.DropDownListFor(m => m.LiveDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                            @Html.LabelFor(m => m.OutrightDelayTimes, ViewResources.Outright, new { @class = "font-normal" })
                            @Html.DropDownListFor(m => m.OutrightDelayTimes, (IEnumerable<SelectListItem>)ViewBag.DelayTimeList, new { @style = "width: 50px" })
                        </div>
                        <div class="grid4" style="text-align: right">
                            @Html.LabelFor(m => m.ResultDelayTimes, ViewResources.ResultDelayTime)
                        </div>
                        <div class="grid7">
                            @Html.DropDownListFor(m => m.ResultDelayTimes, (IEnumerable<SelectListItem>)ViewBag.ResultDelayTimeList, new { @style = "width: 50px" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="grid4" style="text-align: right">
                            @Html.LabelFor(m => m.NumberOfIPs, ViewResources.NumberOfIPs)
                        </div>
                        @Html.TextBoxFor(m => m.NumberOfIPs, new { @style = "width: 50px", @min = 0 })
                        <div class="grid1" style="float: none;">
                            @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                        </div>
                    </div>
                }
                <div class="row">
                    <div class="grid4" style="text-align: right">
                        <label for="id1">@ViewResources.Languages</label>
                    </div>
                    @*@Html.CheckBoxListFor(m => m.LanguageList, ViewBag.LanguageIDList as IEnumerable<SelectListItem>, new { @id = "slLanguage", @Class = "language", @isDisabled = @ViewBag.LanguagesFlag ? "" : "disabled" }, false)*@
                    <div class="grid1" style="float: none;">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
                <div class="row3">
                    @Html.HiddenFor(m => m.SportIDList)

                    <div class="grid4" style="line-height: 170px; text-align: right">
                        <label for="chkAllMajorSports">
                            @ViewResources.MajorSports
                            <input class="hidden" type="checkbox" id="chkAllMajorSports" isdisabled=@(ViewBag.SportsFlag ? "" : "disabled") />
                        </label>
                    </div>
                    <div class="grid7" style="line-height: 170px; text-align: left">
                        <label class="font-normal">
                            @*@Html.CheckBoxListFor(m => m.SportIDList, ViewBag.MajorSportList as IEnumerable<SelectListItem>, new { @Class = "chkMajorSport", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" }, false)*@
                        </label>
                    </div>
                    @{
                        var minorSports = ViewBag.MinorSportList as IEnumerable<SelectListItem>;
                    }
                    <div class="grid4" style="line-height: 170px; text-align: right">
                        <label for="chkAllSports">
                            @ViewResources.MinorSports
                        </label>
                        <input type="checkbox" id="chkAllMinorSports" isdisabled=@(ViewBag.SportsFlag && minorSports.Any() ? "" : "disabled") />
                    </div>
                    <div class="grid7">
                        <div class="checkbox-filter">
                            <label>Search </label>
                            <input id="minorSport-filter" />
                        </div>
                        <div class="grid7 checkbox-list">
                            @*@Html.CheckBoxDropDownListFor(m => m.SportIDList, minorSports, new { @Class = "chkMinorSport", @isDisabled = @ViewBag.SportsFlag ? "" : "disabled" }, false)*@
                        </div>
                    </div>
                    <div class="grid1" style="line-height: 150px; text-align: left">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
                <div class="row3">
                    <div class="grid4" style="line-height: 170px; text-align: right">
                        <label for="chkAllCountries">
                            @ViewResources.Countries
                        </label><input type="checkbox" id="chkAllCountries" isdisabled=@(ViewBag.CountriesFlag ? "" : "disabled") />
                    </div>
                    <div class="grid7">
                        <div class="checkbox-filter">
                            <label>Search </label>
                            <input id="country-filter" />
                        </div>
                        <div class="grid7 checkbox-list">
                            @*@Html.CheckBoxDropDownListFor(m => m.CountryCodeList, (IEnumerable<SelectListItem>)ViewBag.CountriesList, new { @class = "chkCountry", @isDisabled = @ViewBag.CountriesFlag ? "" : "disabled" }, false)*@
                            @Html.HiddenFor(m => m.CountryCodeList)
                        </div>
                    </div>
                    <div class="grid1" style="line-height: 150px; text-align: left">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
                @if (ViewBag.HasAccountManagerPermission == true)
                {
                    @*<div id="League" class="row3">
                        <partial name="_LeaguePartialView" for="@getLeagueCriteria" />
                    </div>
                    <div id="Outrights" class="row3" style="max-height: 210px">
                        <partial name="_OutrightPartialView" for="@getOutRightCriteria" />
                    </div>*@
                }
                <div id="Market" class="row3">
                    @{
                        var minorMarkets = (ViewBag.MinorBettypesList as IEnumerable<SelectListItem>);
                        var majorMarkets = (ViewBag.MajorBettypesList as IEnumerable<SelectListItem>);
                    }
                    <div class="grid4" style="line-height: 170px; text-align: right">
                        <label for="chkAllMajorMarkets">@ViewResources.MajorMarkets</label>
                        <input type="checkbox" id="chkAllMajorMarkets" isdisabled=@(ViewBag.MarketsFlag && majorMarkets.Any() ? string.Empty : "disabled") />
                    </div>
                    <div class="grid7">
                        <div class="checkbox-filter">
                            <label>Search </label>
                            <input id="majormarket-filter" />
                        </div>
                        <div class="grid7 checkbox-list">
                            @*@Html.CheckBoxDropDownListFor(m => m.BetTypeIDList,
                                majorMarkets,
                                new { @Class = "chkMajorMarket", @isDisabled = @ViewBag.MarketsFlag ? "" : "disabled" },
                                false)*@
                        </div>
                    </div>
                    <div class="grid4" style="line-height: 170px; text-align: right">
                        <label for="chkAllMinorMarkets">@ViewResources.MinorMarkets</label>
                        <input type="checkbox" id="chkAllMinorMarkets" isdisabled=@(ViewBag.MarketsFlag && minorMarkets.Any() ? string.Empty : "disabled") />
                    </div>
                    <div class="grid7">
                        <div class="checkbox-filter">
                            <label>Search </label>
                            <input id="minorMarket-filter" />
                        </div>
                        <div class="grid7 checkbox-list">
                            @*@Html.CheckBoxDropDownListFor(m => m.BetTypeIDList,
                                minorMarkets,
                                new { @Class = "chkMinorMarket", @isDisabled = @ViewBag.MarketsFlag ? string.Empty : "disabled" }
                                , false)*@
                        </div>
                    </div>
                    <div class="grid1" style="line-height: 150px; text-align: left">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
                <div class="row">
                    <div class="grid4"></div>
                    <div class="grid2">
                        <a href="@Url.Action("list", "affiliate")" class="button">@ViewResources.Back</a>
                    </div>
                    <div class="grid2">
                        <input id="editStep3Save" type="button" value="@ViewResources.Save" />
                    </div>
                </div>
            </div>
        }
    </div>
}
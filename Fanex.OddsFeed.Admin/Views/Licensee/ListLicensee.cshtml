@model Fanex.OddsFeed.Criteria.Licensee.GetLicenseeByPageCriteria
@{
    ViewBag.IsDashboard = false;
    ViewBag.Title = "Licensee List";
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <span class="step">@ViewBag.Title</span>
}
@section Styles
{
    <link rel="stylesheet" href="~/minify/css/fanexgrid.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/minify/css/licensee.min.css" asp-append-version="true">
}
@section Scripts
{
    
    <environment include="Development">
        <script src="~/minify/js/fanexgrid.min.js" asp-append-version="true"></script>
        <script src="~/js/Functions/ListLicensee/CommonLicensee.js" asp-append-version="true"></script>
        <script src="~/js/Functions/ListLicensee/ListLicensee.js" asp-append-version="true"></script>
        <script src="~/js/Functions/ListLicensee/EditLicensee.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/fanexgrid.min.js" asp-append-version="true"></script>
        <script src="~/minify/js/listlicensee.min.js" asp-append-version="true"></script>
    </environment>
}
<div class="infor">
    <span class="infor-ic">&nbsp;</span><span class="infor-text">The list of licensees.</span>
</div>
<div class="newline">&nbsp;</div>
<div class="result-message-box hidden"></div>
<div>
    <div id="myForm">
        <div class="container_24 bunhat">
            <div class="grid_3 gridlabel">
                @Html.LabelFor(s => s.SystemName, "Licensee Name")
            </div>
            <div class="grid_6">
                @Html.TextBoxFor(s => s.SystemName, new { @onkeyup = "StartAutoSuggesttion()", @class = "licensee-name-autocomplete", placeholder="Licensee Name" })
            </div>
            <div class="grid1">
                <label for="isActive">Active</label>
            </div>
            <div class="grid4">
                <select id="isActive" name="isActive" class="width-auto-fit request">
                    <option value="" selected>All</option>
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
            </div>
            <div class="grid_2">
                <input type="button" value="Search" onclick="Search()">
            </div>
        </div>
        @Html.HiddenFor(s => s.PageSize)
        @Html.HiddenFor(s => s.PageIndex)
        @Html.HiddenFor(s => s.PageCount)
    </div>
</div>
<br />
<div id="SearchResult" class="freegrid  content-grid"></div>

<!-- active confirmation dialog -->
<div id="activeLicenseeDialog" title="LICENSEE ADMIN" style="display: none">
    <p>Do you want to activate this licensee ?</p>
    <br />
    <p>
        <input type="checkbox" id="isActiveAllAffiliate" />
        <label for="isActiveAllAffiliate" style="font-weight:normal">Activate all affiliates also</label>
    </p>
</div>
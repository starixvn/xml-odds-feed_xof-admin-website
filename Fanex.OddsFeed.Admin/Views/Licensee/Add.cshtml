@using Fanex.OddsFeed.Resources
@using Fanex.OddsFeed.Criteria.Licensee
@using Microsoft.AspNetCore.Html;
@model CreateLicenseeCriteria
@{
	ViewBag.IsDashboard = false;
	ViewBag.Title = "Add Licensee";
	var getLeagueCriteria = new GetLeagueCriteria
			{
				SportIDList = Model.SportIDList,
				LeagueIDList = Model.LeagueIDList,
				LeagueIDListFlag = Model.LeagueIDListFlag,
				CountryCodeList = Model.CountryCodeList,
				LeagueKeyword = Model.LeagueKeyword,
				LeagueKeywordFlag = Model.LeagueKeywordFlag
			};
	var getOutRightCriteria = new GetOutRightCriteria
			{
				SportIDList = Model.SportIDList,
				OutRightIDList = Model.OutRightIDList,
				CountryCodeList = Model.CountryCodeList,
				LeagueKeyword_O = Model.LeagueKeyword_O,
				LeagueKeyword_OFlag = Model.LeagueKeyword_OFlag
			};
}
@section Breadcrumb {
	<a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
	<span class="step">@ViewBag.Title</span>
}
@section Styles
	{
	<link rel="stylesheet" href="~/minify/css/licensee.min.css" asp-append-version="true">
	<link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}
@section Scripts
	{
	<environment include="Development">
		<script src="~/js/Functions/ListLicensee/CommonLicensee.js" type="text/javascript"></script>
		<script src="~/js/Functions/ListLicensee/AddLicensee.js" type="text/javascript"></script>
		<script src="~/js/Functions/ListLicensee/AddLicenseeStep1.js" type="text/javascript"></script>
		<script src="~/js/Functions/ListLicensee/AddLicenseeStep2.js" type="text/javascript"></script>
		<script src="~/js/Functions/ListLicensee/AddLicenseeStep3.js" type="text/javascript"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/minify/js/addlicensee.min.js" asp-append-version="true"></script>
	</environment>

	<script type="text/javascript">
		var viewResources = {
			Error_LicenseeNameContent: '@ViewResources.Error_LicenseeNameContent',
			Error_LicenseeNameRequired: '@ViewResources.Error_LicenseeNameRequired',
			Error_LicenseeNameLength: '@ViewResources.Error_LicenseeNameLength',
			Error_Licensee_Existed: '@ViewResources.Error_Licensee_Existed',
			Error_EmailRequired: '@ViewResources.Error_EmailRequired',
			Error_EmailContent: '@ViewResources.Error_EmailContent',
			Error_Require_OddType: '@ViewResources.Error_Require_OddType',
			Error_Require_Deadball_or_Outright: '@ViewResources.Error_Require_Deadball_or_Outright',
			Error_Require_Language: '@ViewResources.Error_Require_Language',
			Error_Require_Sport: '@ViewResources.Error_Require_Sport',
			Error_Require_Country: '@ViewResources.Error_Require_Country',
			Error_Require_Market: '@ViewResources.Error_Require_Market',
			Error_Require_League: '@ViewResources.Error_Require_League',
			Error_Require_Outright: '@ViewResources.Error_Require_Outright',
			Error_Require_NumberOfIPs: '@ViewResources.Error_Require_NumberOfIPs',
			MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
		};
	</script>
}
<div class="infor">
	<span class="infor-ic">&nbsp;</span><span class="infor-text">
		The wizard will help you to create a new licensee in your licensee system.
	</span>
</div>
<div class="newline">&nbsp;</div>
<div class="result-message-box hidden"></div>
<div class="step-reg">
	<div id="panelStep1" class="step-active licensee-info-settings">
		<span class="firstLetter">1</span>
		<span class="normal">Licensee<br /> Information Settings</span>
	</div>
	<div id="panelStep2" class="step-inactive">
		<span class="firstLetter">2</span>
		<span class="normal">Authentication<br /> Settings</span>
	</div>
	<div id="panelStep3" class="step-inactive">
		<span class="firstLetter">3</span>
		<span class="normal">Profile<br /> Settings</span>
	</div>
</div>
<div class="newline">&nbsp;</div>
<form id="formLicensee">
	<div id="step1" class="step">
		<h2>Step 1: Licensee Information Settings</h2>
		<h3>
			@(new HtmlString(ViewResources.HtmlTemplate_InputRequireds))
		</h3>
		<div id="errorStep1" class="validation-summary-errors hidden" data-valmsg-summary="true">
		</div>
		<div class="newline">&nbsp;</div>
		<div class="form" style="width: auto;">
			<div class="row licensee-name hide">
				<div class="grid3">
					<label asp-for="SystemName">Licensee Name</label>
				</div>
				<div class="grid7">
					<input asp-for="SystemName" maxlength="50" />
				</div>
				<div class="gird1" style="text-align: left">
					<span class="red">(*)</span>
				</div>
			</div>
			<div class="row licensee-selection">
				<div class="grid3">
					<label asp-for="LicenseeID">Licensee Name</label>
				</div>
				<div class="grid6">
					<select asp-for="LicenseeID" asp-items="@(new SelectList(ViewBag.LicenseesList, "Value", "Text", null))" class="width-auto-fit width-licensee-name request"></select>
				</div>
			</div>
			<div class="row contact-email">
				<div class="grid3">
					<label asp-for="ContactEmail">Contact Email</label>
				</div>
				<div class="grid7">
					<input asp-for="ContactEmail" maxlength="100" />
				</div>
				<div class="gird1" style="text-align: left">
					<span class="red">(*)</span>
				</div>
			</div>
			<div class="row">
				<div class="grid3">
					<label asp-for="IsActive">Active</label>
				</div>
				<div class="grid6">
					<input asp-for="IsActive" />
				</div>
			</div>
			<div class="row">
				<div class="grid2"></div>
				<div class="grid2">
					<input id="step1Cancel" type="button" value="Cancel" class="cancel" />
				</div>
				<div class="grid2">
					<input id="step1Next" type="button" value="Next" />
				</div>
			</div>
		</div>
	</div>
	<div id="step2" class="step hide">
		<h2>Step 2: Authentication Settings</h2>
		<h3>Each affiliate can only access our XML Odds Feeds data under allowed list of domains and IPs</h3>
		<h3>
			@(new HtmlString(ViewResources.HtmlTemplate_InputRequired))
		</h3>
		<h3 id="errorStep2_NumberOfIPs">Maximum number of IPs = @ViewBag.NumberOfIPs</h3>
		<div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true"></div>
		<div class="form2" style="width: auto;">
			<div class="row3">
				<div class="grid2" style="line-height: 150px; text-align: center">
					<label asp-for="DomainList">Domains</label>
				</div>
				<div class="grid9" style="height: 225px; border-style: solid; border-width: 1px;
                    border-color: #C8C8C8">
					<div class="grid6" style="width: 305px">
						<div class="row">
							<label>@ViewResources.DomainList</label>
						</div>
						<div class="row2">
							<div class="grid4" style="overflow: auto; border: thin none; height: 145px; width: 300px;">
								<select id="ListDomain" asp-items="ViewBag.DomainList" multiple="multiple" size="8" style="width:300px">
								</select>
							</div>
						</div>
						<div class="row">
							<div class="grid4" style="text-align: left; margin-top: 0px">
								<label id="showingDomainListId">@ViewResources.Showing</label>
							</div>
						</div>
					</div>
					<div class="grid2">
						<div class="row"></div>
						<div class="row domainsActionGroup " style="margin-top: 15px; margin-left: -25px">
							<span id="btnRight" class="arrow right"></span>
							<br />
							<span id="btnDoubleRight" class="arrow doubleright"></span>
							<br />
							<span id="btnLeft" class="arrow left"></span>
							<br />
							<span id="btnDoubleLeft" class="arrow doubleleft"></span>
						</div>
					</div>
					<div class="grid6" style="width: 305px">
						<div class="row">
							<label>@ViewResources.AssignedDomains</label>
						</div>
						<div class="row2">
							<div class="grid4" style="overflow: auto; border: thin none; height: 145px; width: 300px;">
								<select id="AssignedDomainList" asp-items="(new List<SelectListItem>())" multiple="multiple" size="8" style="width:300px">
								</select>
							</div>
						</div>
						<div class="row">
							<div class="grid4" style="text-align: left; margin-top: 0px">
								<label id="showingAssignedDomainId">@ViewResources.Showing</label>
							</div>
						</div>
					</div>
					<div class="grid1" style="line-height: 150px; text-align: left">
						<span class="red">(*)</span>
					</div>
				</div>
			</div>
			<input type="hidden" asp-for="DomainList" />
			<div id="IpDiv" class="row2" style="margin-top: 35px;">
				<div class="grid2" style="line-height: 70px; text-align: center">
					<label for="id2">@ViewResources.IP</label>
				</div>
				<div class="grid8">
					<table id="IpTable" style="width: 100%">
						<thead>
							<tr>
								<th style="width: 40%">
									<label style="text-align: center">@ViewResources.IPFrom</label>
								</th>
								<th style="width: 40%">
									<label style="text-align: center">@ViewResources.IPTo</label>
								</th>
								<th style="width: 10%">
									<label style="text-align: center">@ViewResources.Action</label>
									<span id="addNewIP" title="Add" class="action addnew"></span>
								</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<input name="FromIP" type="text" />
								</td>
								<td>
									<input name="ToIP" type="text" />
								</td>
								<td>
									<span style="padding-left: 30px"></span>
									<span title="Delete" class="action del" onclick="removeRowTemporary(this);"></span>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<input type="hidden" asp-for="ListIPFrom" />
			<input type="hidden" asp-for="ListIPTo" />
			<div class="row">
				<div class="grid2"></div>
				<div class="grid2">
					<input id="step2Cancel" type="button" value="Cancel" class="cancel" />
				</div>
				<div class="grid2">
					<input id="step2Previous" type="button" value="Previous" />
				</div>
				<div class="grid2">
					<input id="step2Next" type="button" value="Next" />
				</div>
			</div>
		</div>
	</div>
	<div id="step3" class="step hide">
		<h2>Step 3: Profile Settings</h2>
		<h3>Profile will show which data (sports, markets, results, ...) affiliate should have in their xml stream.</h3>
		<h3>
			@(new HtmlString(ViewResources.HtmlTemplate_InputRequireds))
		</h3>
		<div id="errorStep3" class="validation-summary-errors" data-valmsg-summary="true"></div>
		<div class="form2" style="width: auto;">
			<div class="row">
				<div class="grid4" style="text-align: right">
					<label asp-for="OddsType">@ViewResources.OddsType</label>
				</div>
				@foreach (var item in (ViewBag.OddsTypeList as IEnumerable<SelectListItem>)!)
				{
					<label class="font-normal">
						<input class="oddstype" @(Model.OddsType.Contains(item.Value) ? "checked" : "")
							   id="@("OddsType" + item.Value)" type="checkbox" value="@item.Value">
						@item.Text
					</label>
				}
				<input type="hidden" asp-for="OddsType" />
				<input type="checkbox" asp-for="OddsTypeFlag" />
				<label asp-for="OddsTypeFlag" class="font-normal">Editable</label>
				@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
			</div>
			<div class="row">
				<div class="grid4" style="text-align: right">
					<label asp-for="OddsRegion">@ViewResources.OddsStyle</label>
				</div>
				<select asp-for="OddsRegion" asp-items="(IEnumerable<SelectListItem>)ViewBag.OddsStyleList"></select>
				<input asp-for="OddsRegionFlag" />
				<label asp-for="OddsRegionFlag" class="font-normal">Editable</label>
			</div>
			<div class="row">
				<div class="grid4" style="text-align: right">
					<label asp-for="OddsDelayTimes">@ViewResources.OddsDelayTime</label>
				</div>
				<div class="grid7">
					<label asp-for="DeadballDelayTimes" class="font-normal">@ViewResources.Deadball</label>
					<select asp-for="DeadballDelayTimes" asp-items="(IEnumerable<SelectListItem>)ViewBag.DelayTimeList" style="width: 50px"></select>

					<label asp-for="LiveDelayTimes" class="font-normal">Live</label>
					<select asp-for="LiveDelayTimes" asp-items="(IEnumerable<SelectListItem>)ViewBag.DelayTimeList" style="width: 50px"></select>

					<label asp-for="OutrightDelayTimes" class="font-normal">@ViewResources.Outright</label>
					<select asp-for="OutrightDelayTimes" asp-items="(IEnumerable<SelectListItem>)ViewBag.DelayTimeList" style="width: 50px"></select>
				</div>
				<div class="grid4" style="text-align: right">
					<label asp-for="ResultDelayTimes">@ViewResources.ResultDelayTime</label>
				</div>
				<div class="grid7">
					<select asp-for="ResultDelayTimes" asp-items="(IEnumerable<SelectListItem>)ViewBag.ResultDelayTimeList" style="width: 50px"></select>
				</div>
			</div>
			<div class="row">
				<div class="grid4" style="text-align: right">
					<label asp-for="NumberOfIPs">@ViewResources.NumberOfIPs</label>
				</div>
				<input asp-for="NumberOfIPs" style="width: 50px" min="0" />
				<div class="grid1" style="float: none;">
					@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
				</div>
			</div>
			<div class="row">
				<div class="grid4" style="text-align: right">
					<label asp-for="LanguageList">@ViewResources.Languages</label>
				</div>
				@foreach (var item in (ViewBag.LanguageIDList as IEnumerable<SelectListItem>)!)
				{
					<label class="font-normal">
						<input class="language" @(Model.LanguageList.Contains(item.Value) ? "checked" : "")
							   id="@("LanguageList" + item.Value)" type="checkbox" value="@item.Value">
						@item.Text
					</label>
				}
				<input type="hidden" asp-for="LanguageList" />
				<input type="checkbox" asp-for="LanguageListFlag" />
				<label asp-for="LanguageListFlag" class="font-normal">Editable</label>
				@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
			</div>
			<div class="row3">
				<input type="hidden" asp-for="SportIDList" />
				<div class="grid4" style="line-height: 170px; text-align: right">
					<label for="chkAllMajorSports">
						@ViewResources.MajorSports
						<input class="hidden" type="checkbox" id="chkAllMajorSports" />
					</label>
				</div>
				<div class="grid7" style="line-height: 170px; text-align: left">
					<label class="font-normal">
						@foreach (var item in (ViewBag.MajorSportList as IEnumerable<SelectListItem>)!)
						{
							<label class="font-normal">
								<input class="chkMajorSport" @(Model.SportIDList.Contains(item.Value) ? "checked" : "")
									   id="@("SportIDList" + item.Value)" type="checkbox" value="@item.Value">
								@item.Text
							</label>
						}
					</label>
				</div>
				<div class="grid4" style="line-height: 170px; text-align: right">
					<label for="chkAllSports">@ViewResources.MinorSports</label>
					<input type="checkbox" id="chkAllMinorSports" />
				</div>
				<div class="grid7">
					<div class="checkbox-filter">
						<label>Search </label>
						<input id="minorSport-filter" />
					</div>
					<div class="grid7 checkbox-list">
						@foreach (var item in (ViewBag.MinorSportList as IEnumerable<SelectListItem>)!)
						{
							<div>
								<input @(Model.SportIDList.Contains(item.Value) ? "checked" : "")
									   class="chkMinorSport" id="@("chkMinorSport" + item.Value)" name="chkMinorSport" type="checkbox" value="@item.Value">
								<label class="font-normal" for="@("chkMinorSport" + item.Value)">@item.Text</label>
							</div>
						}
					</div>
				</div>
				<div class="grid3" style="line-height: 170px; text-align: left">
					<input type="checkbox" asp-for="SportIDListFlag" />
					<label asp-for="SportIDListFlag" class="font-normal">Editable</label>
				</div>
				<div class="grid1" style="line-height: 170px;">
					@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
				</div>
			</div>
			<div class="row3">
				<div class="grid4" style="line-height: 170px; text-align: right">
					<label asp-for="CountryCodeList">Countries</label>
					<input type="checkbox" id="chkAllCountries" />
				</div>
				<div class="grid7">
					<div class="checkbox-filter">
						<label>Search </label>
						<input id="country-filter" />
					</div>
					<div class="grid7 checkbox-list">
						@foreach (var item in (ViewBag.CountriesList as IEnumerable<SelectListItem>)!)
						{
							<div>
								<input @(Model.CountryCodeList.Contains(item.Value) ? "checked" : "")
									   class="chkCountry" id="@("chkCountry" + item.Value)" name="chkCountry" type="checkbox" value="@item.Value">
								<label class="font-normal" for="@("chkCountry" + item.Value)">@item.Text</label>
							</div>
						}
						<input type="hidden" asp-for="CountryCodeList" />
					</div>
				</div>
				<div class="grid3" style="line-height: 170px; text-align: left">
					<input type="checkbox" asp-for="CountryCodeListFlag" />
					<label asp-for="CountryCodeListFlag" class="font-normal">Editable</label>
				</div>
				<div class="grid1" style="line-height: 170px;">
					@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
				</div>
			</div>
			<div id="League" class="row3">
				<partial name="_LeaguePartialView" for="@getLeagueCriteria" />
			</div>
			<div id="Outrights" class="row3" style="max-height: 210px">
				<partial name="_OutrightPartialView" for="@getOutRightCriteria" />
			</div>
			<div id="Market" class="row3">
				<input type="hidden" asp-for="BetTypeIDList" />
				<div class="grid4" style="line-height: 170px; text-align: right">
					<label for="chkAllMajorMarkets">@ViewResources.MajorMarkets</label>
					<input type="checkbox" id="chkAllMajorMarkets" />
				</div>
				<div class="grid7">
					<div class="checkbox-filter">
						<label>Search </label>
						<input id="majormarket-filter" />
					</div>
					<div class="grid7 checkbox-list">
						@foreach (var item in (ViewBag.MajorBettypesList as IEnumerable<SelectListItem>)!)
						{
							<div>
								<input @(Model.BetTypeIDList.Contains(item.Value) ? "checked" : "")
									   class="chkMajorMarket" id="@("chkMajorMarket" + item.Value)" name="chkMajorMarket" type="checkbox" value="@item.Value">
								<label class="font-normal" for="@("chkMajorMarket" + item.Value)">@item.Text</label>
							</div>
						}
					</div>
				</div>
				<div class="grid4" style="line-height: 170px; text-align: right">
					<label for="chkAllMinorMarkets">@ViewResources.MinorMarkets</label>
					<input type="checkbox" id="chkAllMinorMarkets" />
				</div>
				<div class="grid7">
					<div class="checkbox-filter">
						<label>Search </label>
						<input id="minorMarket-filter" />
					</div>
					<div class="grid7 checkbox-list">
						@foreach (var item in (ViewBag.MinorBettypesList as IEnumerable<SelectListItem>)!)
						{
							<div>
								<input @(Model.BetTypeIDList.Contains(item.Value) ? "checked" : "")
									   class="chkMinorMarket" id="@("chkMinorMarket" + item.Value)" name="chkMinorMarket" type="checkbox" value="@item.Value">
								<label class="font-normal" for="@("chkMinorMarket" + item.Value)">@item.Text</label>
							</div>
						}
					</div>
				</div>
				<div class="grid3" style="line-height: 170px; text-align: left">
					<input type="checkbox" asp-for="BettypeIDListFlag" />
					<label asp-for="BettypeIDListFlag" class="font-normal">Editable</label>
				</div>
				<div class="grid1" style="line-height: 170px;">
					@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))
				</div>
			</div>
			<div class="row">
				<div class="grid4"></div>
				<div class="grid2">
					<input id="step3Cancel" type="button" value="Cancel" class="cancel" />
				</div>
				<div class="grid2">
					<input id="step3Previous" type="button" value="Previous" />
				</div>
				<div class="grid2">
					<input id="step3Done" type="button" value="Done" />
				</div>
			</div>
		</div>
	</div>
</form>

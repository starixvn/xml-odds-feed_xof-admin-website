@using Fanex.OddsFeed.Resources
@using Microsoft.AspNetCore.Html;
@model Fanex.OddsFeed.Criteria.Licensee.EditLicenseeSettingCriteria
@{
    ViewBag.IsDashboard = false;
    ViewBag.Title = "Edit authentication settings";
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("ListLicensee", "Licensee")">Licensee List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentSystem</span>
}
@section Styles
    {
    <link rel="stylesheet" href="~/minify/css/affiliate.min.css" asp-append-version="true">
}
@section Scripts
    {
    <environment include="Development">
        <script src="~/js/Functions/ListLicensee/CommonLicensee.js" type="text/javascript"></script>
        <script src="~/js/Functions/ListLicensee/EditLicenseeSetting.js" type="text/javascript"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/minify/js/editsettinglicensee.min.js" asp-append-version="true"></script>
    </environment>
    <script type="text/javascript">
        var viewResources = {
            MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
        };
    </script>
}
<div id="step2" class="step">
    <form id="formEditLicenseeSetting">
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">Authentication Settings.</span>
        </div>
        <h3>
            @(new HtmlString(ViewResources.HtmlTemplate_InputRequired))
        </h3>
        <h3 id="errorStep2_NumberOfIPs">
            Maximum number of IPs = @ViewBag.NumberOfIPs
        </h3>
        <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">
        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="newline">
            &nbsp;
        </div>
        <div class="form2 formAssignDomainSetting">
            <input type="hidden" asp-for="SystemID" />
            <div class="licensee-assign-domain">
                <div style="width: 70px;"><label asp-for="DomainList">Domains</label></div>
                <div>
                    <div><label>Domain List</label></div>
                    <select id="ListDomain" asp-items="ViewBag.DomainList" multiple="multiple" size="8"></select>
                    <div style="text-align: left;"><label id="showingDomainListId">@ViewResources.Displaying</label></div>
                </div>
                <div class="domainsActionGroup">
                    <span id="btnRight" class="arrow right"></span>
                    <br />
                    <span id="btnDoubleRight" class="arrow doubleright"></span>
                    <br />
                    <span id="btnLeft" class="arrow left"></span>
                    <br />
                    <span id="btnDoubleLeft" class="arrow doubleleft"></span>
                </div>
                <div>
                    <div><label>@ViewResources.AssignedDomains</label></div>
                    <select id="AssignedDomainList" asp-items="ViewBag.SelectedDomainList" multiple="multiple" size="8"></select>
                    <div style="text-align: left;"><label id="showingAssignedDomainId">@ViewResources.Displaying</label></div>
                </div>
                <div>@(new HtmlString(ViewResources.HtmlTemplate_InputRequiredSymbol))</div>
            </div>
            <input type="hidden" asp-for="DomainList" />
            <div id="IpDiv" class="row2" style="margin-top: 10px;">
                <div class="grid2" style="line-height: 70px; text-align: center">
                    <label for="id2">
                        @ViewResources.IP
                    </label>
                </div>
                <div class="grid8">
                    <table id="IpTable" style="width: 100%">
                        <thead>
                            <tr>
                                <th style="width: 40%">
                                    <label style="text-align: center">
                                        @ViewResources.IPFrom
                                    </label>
                                </th>
                                <th style="width: 40%">
                                    <label style="text-align: center">
                                        @ViewResources.IPTo
                                    </label>
                                </th>
                                <th style="width: 10%">
                                    <label style="text-align: center">
                                        @ViewResources.Action
                                    </label>
                                    <span id="newIP" title="Add" class="action addnew"></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input name="FromIP" type="text" />
                                </td>
                                <td>
                                    <input name="ToIP" type="text" />
                                </td>
                                <td>
                                    <span style="padding-left: 19px"></span><span title="Edit" class="action save" onclick="SaveIPSetting(this)">
                                    </span><span style="padding-left: 30px"></span><span title="Delete" class="action del" onclick="removeRow(this);">
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <input type="hidden" asp-for="ListIPFrom" />
            <input type="hidden" asp-for="ListIPTo" />
            <div class="row">
                <div class="grid2">
                </div>
                <div class="grid2">
                    <input id="Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="Save" type="button" value="Save" />
                </div>
            </div>
        </div>
    </form>
</div>

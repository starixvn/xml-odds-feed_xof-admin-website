@using Fanex.OddsFeed.Core.Web
@using Fanex.OddsFeed.Core
@model Fanex.OddsFeed.Core.Criteria.Licensee.EditLicenseeSettingCriteria
@{
    ViewBag.Title = "Edit authentication settings";
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("ShowDashboard", "Dashboard")"><span class='xicon home'></span>Home</a>
    <a class="step" href="@Url.Action("ListLicensee", "Licensee")">Licensee List</a>
    <span class="step">@ViewBag.Title @ViewBag.CurrentSystem</span>
}
@section Styles
{
    @*<link rel="Stylesheet" type="text/css" href="@BundleTable.Bundles.ResolveBundleUrl("~/App_Themes/Default/Affiliate/AffiliateCss")" />*@
}
@section Scripts
{
    <script src="~/Scripts/Functions/ListLicensee/CommonLicensee.js" type="text/javascript"></script>
    <script src="~/Scripts/Functions/ListLicensee/EditLicenseeSetting.js" type="text/javascript"></script>
    <script type="text/javascript">
         var viewResources = {
             MaximumNumberOfIPs: '@ViewResources.MaximumNumberOfIPs'
         };
    </script>
}
<div id="step2" class="step">
    @using (Html.BeginForm("Home", "Index", FormMethod.Post, new { id = "formEditLicenseeSetting" }))
    {
        <div class="infor">
            <span class="infor-ic"></span><span class="infor-text">Authentication Settings.</span>
        </div>
        <h3>
            @Html.Raw(ViewResources.HtmlTemplate_InputRequired)
        </h3>
        <h3 id="errorStep2_NumberOfIPs">
            Maximum number of IPs = @ViewBag.NumberOfIPs
        </h3>
        <div id="errorStep2" class="validation-summary-errors hidden" data-valmsg-summary="true">

        </div>
        <div class="result-message-box hidden">
        </div>
        <div class="newline">
            &nbsp;
        </div>
        <div class="form2 formAssignDomainSetting">
            @Html.HiddenFor(m => m.SystemID)
            <div class="row3">
                <div class="grid2" style="line-height: 150px; text-align: center">
                    @Html.LabelFor(m => m.DomainList, "Domains")
                </div>
                <div class="grid9" style="height: 220px;border-style: solid; border-width: 1px; border-color: #C8C8C8">
                    <div class="grid6" style="width: 305px">
                        <div class="row">
                            @Html.Label("Domain List")
                        </div>
                        <div class="row2">
                            <div class="grid4">
                                @Html.ListBox("ListDomain", (IEnumerable<SelectListItem>)ViewBag.DomainList, new { style = "width:300px", size = 8 })
                            </div>
                        </div>
                        <div class="row">
                            <div class="grid4" style="text-align: left; margin-top: 20px">
                                @Html.Label("leftShowing", ViewResources.Displaying, new { id = "showingDomainListId" })
                            </div>
                        </div>
                    </div>
                    <div class="grid2">
                        <div class="row">
                        </div>
                        <div class="row domainsActionGroup" style="margin-top: 15px; margin-left: -25px">
                            <span id="btnRight" class="arrow right"></span>
                            <br />
                            <span id="btnDoubleRight" class="arrow doubleright"></span>
                            <br />
                            <span id="btnLeft" class="arrow left"></span>
                            <br />
                            <span id="btnDoubleLeft" class="arrow doubleleft"></span>
                        </div>
                    </div>
                    <div class="grid6" style="width: 305px">
                        <div class="row">
                            @Html.Label(ViewResources.AssignedDomains)
                        </div>
                        <div class="row2">
                            <div class="grid4">
                                @Html.ListBox("AssignedDomainList", (List<SelectListItem>)ViewBag.SelectedDomainList, new { style = "width:300px", size = 8 })
                            </div>
                        </div>
                        <div class="row">
                            <div class="grid4" style="text-align: left; margin-top: 20px">
                                @Html.Label("rightShowing", ViewResources.Displaying, new { id = "showingAssignedDomainId" })
                            </div>
                        </div>
                    </div>
                    <div class="grid1" style="line-height: 150px; text-align: left">
                        @Html.Raw(ViewResources.HtmlTemplate_InputRequiredSymbol)
                    </div>
                </div>
            </div>
            @Html.HiddenFor(m => m.DomainList)
            <div id="IpDiv" class="row2" style="margin-top: 10px;">
                <div class="grid2" style="line-height: 70px; text-align: center">
                    <label for="id2">
                        @ViewResources.IP
                    </label>
                </div>
                <div class="grid8">
                    <table id="IpTable" style="width: 100%">
                        <thead>
                            <tr>
                                <th style="width: 40%">
                                    <label style="text-align: center">
                                        @ViewResources.IPFrom
                                    </label>
                                </th>
                                <th style="width: 40%">
                                    <label style="text-align: center">
                                        @ViewResources.IPTo
                                    </label>
                                </th>
                                <th style="width: 10%">
                                    <label style="text-align: center">
                                        @ViewResources.Action
                                    </label>
                                    <span id="newIP" title="Add" class="action addnew"></span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <input name="FromIP" type="text" />
                                </td>
                                <td>
                                    <input name="ToIP" type="text" />
                                </td>
                                <td>
                                    <span style="padding-left: 19px"></span><span title="Edit" class="action save" onclick="SaveIPSetting(this)">
                                    </span><span style="padding-left: 30px"></span><span title="Delete" class="action del" onclick="removeRow(this);">
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            @Html.HiddenFor(m => m.ListIPFrom)
            @Html.HiddenFor(m => m.ListIPTo)
            <div class="row">
                <div class="grid2">
                </div>
                <div class="grid2">
                    <input id="Cancel" type="button" value="Cancel" class="cancel" />
                </div>
                <div class="grid2">
                    <input id="Save" type="button" value="Save" />
                </div>
            </div>
        </div>
    }
</div>

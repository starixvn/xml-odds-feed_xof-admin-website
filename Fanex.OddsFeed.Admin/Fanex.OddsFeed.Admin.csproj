<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Remove="App_GlobalResources\Lang.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_GlobalResources\Lang.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Lang.designer.cs</LastGenOutput>
      <Generator>GlobalResourceProxyGenerator</Generator>
    </Content>
  </ItemGroup>

  <ItemGroup>
	<None Update="App_Data\**\*">
		<CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.3" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="1.0.6" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.5" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.1.1" />
    <PackageReference Include="ONEbook.UM.AspNetCore.Filters" Version="3.1.1.1" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.2" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\minify\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.OddsFeed.Core\Fanex.OddsFeed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="App_GlobalResources\Lang.designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Lang.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

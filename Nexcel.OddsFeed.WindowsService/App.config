    </assemblyBinding>
  </runtime>
  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" 
              UMAddress="tcp://10.40.40.150:8990/UMControllerInterface"
              EnableCheckUM="false" 
              EnableUnscheduledUM="false" 
              UMFrom="03:00" UMTo="04:00" SiteId="2000007" UMPageUrl="~/UserLogin/Common/Offline"> 

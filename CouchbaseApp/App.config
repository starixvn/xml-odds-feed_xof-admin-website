  <couchbase>
    <servers>
      <add uri="http://10.35.35.253:8091/pools" />
    </servers>
    <buckets>
      <add name="oddsfeedTest" password="" />
    </buckets>
  </couchbase>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/Local" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.19.10.74\private$\entlib" defaultCategory="XML-Odds-Feed-WindowsService" />
  
  <appSettings>
    <add key="Interval" value="20" />
    <add key="NumTries" value="5" />
    <!--Number of tries of setting a value of key in Couchbase before giving up-->
    <add key="TotalVersion" value="17" />
    <!-- in milisecond and % 1000 = 0-->
    <add key="MaxTimeRangeLive" value="300" />
    <!--in second-->
    <add key="MaxTimeRangeDeadball" value="120" />
    <!--in second-->
    <add key="MaxTimeRangeOutright" value="120" />
    <!--in second-->
    <add key="SP.Live" value="true" />
    <add key="SP.Suffix" value="" />
    <!--Url use for checking downtime-->
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Cache.Prefix" value="apollo" />
    <add key="FromMail" value="sb1@1100011.com" />
    <add key="ToMail" value="alex.nguyen@starixsoft.com" />
    <add key="CCMail" value="alex.nguyen@starixsoft.com" />
    <add key="BCCMail" value="alex.nguyen@starixsoft.com" />
    <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService" />
    <add key="app_mail_id" value="2" />
    <add key="Environment" value=" at Local Development" />
    <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json" />
    <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
    <add key="CouchbaseServer" value="http://10.35.35.253:8091/pools" />
    <add key="Bucket.OddsFeed" value="oddsfeedTest" />
    <add key="Bucket.Outrights" value="outrights" />
    <add key="Bucket.LiveMatches" value="livematches" />
    <add key="Bucket.DeadMatches" value="deadmatches" />
  </appSettings>
  
  <connectionStrings>
    <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.234;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet;Asynchronous Processing=true; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
  </connectionStrings>
  
  <startup> 
      <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>   
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/Local" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.35.35.254\private$\entlib" defaultCategory="XML-Odds-Feed-Service-LOCAL" />
  
  <appSettings>
    <add key="Interval" value="5000" />
    <add key="NumTries" value="5" /> <!--Number of tries of setting a value of key in Couchbase before giving up-->
    <add key="TotalVersion" value="60" />
    <!-- in milisecond and % 1000 = 0-->
    <add key="MaxTimeRangeLive" value="300" />
    <!--in second-->
    <add key="MaxTimeRangeDeadball" value="120" />
    <!--in second-->
    <add key="MaxTimeRangeOutright" value="120" />
    <!--in second-->
    <add key="SP.Live" value="true" />
    <add key="SP.Suffix" value="" />
    <!--Url use for checking downtime-->
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Cache.Prefix" value="apollo" />
    <add key="FromMail" value="sb1@1100011.com" />
    <add key="ToMail" value="alex.nguyen@starixsoft.com" />
    <add key="CCMail" value="alex.nguyen@starixsoft.com" />
    <add key="BCCMail" value="alex.nguyen@starixsoft.com" />
    <add key="app_mail_address" value="net.tcp://ha.nexdev.net:8787/mailservice" />
    <add key="app_mail_id" value="2" />
    <add key="Environment" value=" at Local Development" />
    <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json" />
    <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
    <add key="CouchbaseServer" value="http://10.18.200.124:8091/pools" />
    <add key="Bucket.OddsFeed" value="oddsfeedTest" />
    <add key="Bucket.Outrights" value="outrights" />
    <add key="Bucket.LiveMatches" value="livematches" />
    <add key="Bucket.DeadMatches" value="deadmatches" />
  </appSettings>
  <connectionStrings>    
    <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.232;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet;Asynchronous Processing=true; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false"
                EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000007"
                UMPageUrl="~/UserLogin/Common/Offline">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Couchbase.NetClient" publicKeyToken="05e9c6b5a9ec94c2" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.4.0.0" newVersion="2.4.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  </configuration>

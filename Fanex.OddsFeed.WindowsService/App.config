<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />    
    
    
    
  <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" /><section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" /><section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" /></configSections>
  
  <couchbase>
    <servers bucket="oddsfeed" bucketPassword="" retryCount="0" retryTimeout="00:00:10">
      <add uri="http://10.18.200.124:8091/pools/default" />
    </servers>
    <socketPool connectionTimeout="00:00:30" deadTimeout="00:00:30" />
  </couchbase>

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/Local" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.19.10.74\private$\entlib" defaultCategory="General" />
  
  <appSettings>
    <add key="Interval" value="5000" />
    <add key="NumTries" value="5" /> <!--Number of tries of setting a value of key in Couchbase before giving up-->
    <add key="TotalVersion" value="60" />
    <!-- in milisecond and % 1000 = 0-->
    <add key="MaxTimeRangeLive" value="300" />
    <!--in second-->
    <add key="MaxTimeRangeDeadball" value="120" />
    <!--in second-->
    <add key="MaxTimeRangeOutright" value="120" />
    <!--in second-->
    <add key="SP.Live" value="true" />
    <add key="SP.Suffix" value="" />
    <!--Url use for checking downtime-->
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Cache.Prefix" value="apollo" />
    <add key="FromMail" value="sb1@1100011.com" />
    <add key="ToMail" value="alex.nguyen@starixsoft.com" />
    <add key="CCMail" value="alex.nguyen@starixsoft.com" />
    <add key="BCCMail" value="alex.nguyen@starixsoft.com" />
    <add key="app_mail_address" value="net.tcp://10.18.200.209:8787/MailService" />
    <add key="app_mail_id" value="2" />
    <add key="Environment" value=" at Local Development" />
    <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json" />
    <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
  </appSettings>
  <connectionStrings>    
    <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.234;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet;Asynchronous Processing=true; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>

  <runtime>

<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/UAT" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.73\msmq\private$\entlib" defaultCategory="XML-Odds-Feed-Service-UAT"/>
  
  <appSettings>
    <add key="Interval" value="20" />
    <add key="NumTries" value="5" />
    <!--Number of tries of setting a value of key in Couchbase before giving up-->
    <add key="TotalVersion" value="17" />
    <!-- in milisecond and % 1000 = 0-->
    <add key="MaxTimeRangeLive" value="300" />
    <!--in second-->
    <add key="MaxTimeRangeDeadball" value="120" />
    <!--in second-->
    <add key="MaxTimeRangeOutright" value="120" />
    <!--in second-->
    <add key="SP.Live" value="true" />
    <add key="SP.Suffix" value="_xpre" />
    <add key="SP.LiveOdds" value="Is_Odds_GetLiveOddsData" />
    <add key="SP.DeadballOdds" value="Is_Odds_GetDeadballOddsData" />
    <add key="SP.OutrightOdds" value="Is_Odds_GetOutrightOddsData" />
    <add key="SP.GetProfile" value="Is_Odds_OddsProfileByPartnerSel" />
    <add key="SP.CheckPermission" value="Odds_PartnerCheckPermission_xpre" />
    <!--Url use for checking downtime-->
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="Cache.Prefix" value="apollo" />
    <add key="FromMail" value="sb1@1100011.com" />
    <add key="ToMail" value="alex.nguyen@starixsoft.com" />
    <add key="CCMail" value="" />
    <add key="BCCMail" value="" />

    <add key="app_mail_address" value="net.tcp://10.40.40.73:8787/mailservice"/>
    <add key="app_mail_id" value="18"/>
    <add key="mailTo" value=""/>

    <add key="Environment" value="UAT" />
    <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json"/>
    <add key="BetTypeSchemaKey" value="BetTypeSchemaKey"/>
    <add key="CouchbaseServer" value="http://localhost:8091/pools" />
    <add key="Bucket.OddsFeed" value="oddsfeed" />
    <add key="Bucket.Outrights" value="outrights" />
    <add key="Bucket.LiveMatches" value="livematches" />
    <add key="Bucket.DeadMatches" value="deadmatches" />
  </appSettings>
  <connectionStrings>
    <add name="DBMA.bodb_Maintenance.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.92;Initial Catalog=bodb_maintenance;integrated security=false;user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
    <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.100;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;"/>
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" EnableCheckUM="true"
              EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000007"
              UMPageUrl="~/UserLogin/Common/Offline">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>
<configuration>
  <configSections>
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <couchbase>
    <servers bucket="XMLOddsFeedPro" bucketPassword="" retryCount="0" retryTimeout="00:00:10">
      <add uri="http://localhost:8091/pools" />
    </servers>
    <socketPool connectionTimeout="00:00:30" deadTimeout="00:00:30" />
  </couchbase>

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/Local" enableWatching="0" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="XML-Odds-Feed"/>
  
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="CacheTime" value="10" />
    <add key="TotalVersion" value="60" />
    <add key="LiveCacheTime" value="30" />
    <add key="Interval" value="5000" />
    <add key="ServerPool" value="127.0.0.1:11211" />
    <add key="SP.Live" value="true" />
    <add key="SP.Suffix" value="_xpre" />

    <!--Flag to disable UM Time-->
    <add key="IsDisableUMTimeFlag" value="false" />
    <!--Url use for checking downtime-->
    <add key="UMCtrlUrl" value="" />
    <!--tcp://10.40.40.150:8990/UMControllerInterface-->

    <!--IP for testing in UM Time-->
    <add key="IPTestingUMTime" value="10.21.10.48" />
    <!--SP for testing in UM Time-->
    <add key="SPTestingUMTime" value="Portal_BetDaq_InsertBet_V2" />
    <!--Flag to disable UM Time-->
    <add key="IsDisableUMTimeFlag" value="true" />

    <add key="Cache.Prefix" value="apollo" />
    <add key="Environment" value="Production" />
    <add key="FeedUrlPath" value="" />
    <add key="VirtualPathWebService" value="feeds" />
    <add key="LimitedOptions" value="5"/>
    <add key="HighlightSportType" value=""/>
    <add key="HighlightBetType" value="412,417,418,419,420,421,422,423,424,425,426,429,445,446,447" />
    <add key="BetTypeSchemaPath" value="Bin\BetTypeSchema\BetTypes.json"/>
    <add key="BetTypeSchemaKey" value="BetTypeSchemaKey"/>
  </appSettings>
  <connectionStrings>
    <add name="DBMA.bodb_Maintenance.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.92;Initial Catalog=bodb_maintenance;integrated security=false;user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.100;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="DBEXT.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.92;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="DBODDSFEED.bodb_OddsFeed.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.92;Initial Catalog=bodb_oddsfeed;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    <add name="DBPRO.bodb02.portal" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.40;Initial Catalog=bodb02;integrated security=false; user id=portal; password=GOs1xyWXqlyDlnK4ndfPRQ==;"/>
    <add name="DBTXN.bodb02.portal" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.17;Initial Catalog=bodb02;integrated security=false; user id=portal; password=GOs1xyWXqlyDlnK4ndfPRQ==;"/>
  </connectionStrings>
  <system.web>
    <customErrors mode="Off"></customErrors>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Helpers, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <authentication mode="Forms">
      <forms loginUrl="~/Account/LogOn" timeout="2880" />
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
  <log4net>
    <appender name="Performance-Log" type="log4net.Appender.RollingFileAppender">
      <file value="Logs-Performance\" />
      <datePattern value="dd.MM.yyyy'.log'" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="1MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%message%newline" />
      </layout>
    </appender>

    <logger name="LogService">
      <level value="INFO" />
      <appender-ref ref="Performance-Log" />
    </logger>
  </log4net>
  <ONEbook.UM ServiceUris="http://10.40.40.22:8889/api" 
              EnableCheckUM="true" EnableUnscheduledUM="false" 
              UMFrom="03:00" UMTo="04:00" SiteId="2000007" 
              UMPageUrl="~/UserLogin/Common/Offline">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>
</configuration>
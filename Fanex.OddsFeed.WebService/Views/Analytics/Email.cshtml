@{
    ViewBag.Title = "Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Email sending testing</h2>
@using (Html.BeginForm())
{
    <div>
        To
    </div>
    <div>
        <input type="text" name="to" />
    </div>
    <div>
        Content
    </div>
    <div>
        <textarea name="content" rows="8" cols="100">Email sending testing</textarea>
    </div>
    <div>
        <input type="submit" value="Send" />
    </div>
    if (ViewBag.Sent == true)
    {
        <h3>Email was sent!</h3> 
    }
    if (ViewBag.Sent == false)
    {
        <h3>Sending fail!</h3> 
    }
}
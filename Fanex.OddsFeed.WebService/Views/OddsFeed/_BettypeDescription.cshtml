@model Fanex.OddsFeed.Library.OddsProfile

@if (Model.BetTypes == null || Model.BetTypes.Contains(221))
{
    <li>
        t="nxt1" : Next 1 minutes
        <ul>
            <li>g: Price for Goal</li>
            <li>c: Price for Corner</li>
            <li>fk: Price for Free Kick</li>
            <li>gk: Price for Goal Kick</li>
            <li>ti: Price for Throw In</li>
            <li>intervals: Indicates offered intervals. For example:
                <br>&nbsp;&nbsp;&nbsp; intervals = 1 for 00:00 - 00:59
                <br>&nbsp;&nbsp;&nbsp; intervals = 2 for 01:00 - 01:59
                <br>&nbsp;&nbsp;&nbsp; intervals = 90 for 89:00 - 89:59
            </li>
        </ul>
    </li>
}

  <Function Name="BetTypeSportType">
    <Setting Key="SP.SportType" SpName="Odds_Partner_SportTypeSel" DbName="DBODDSFEED.bodb_OddsFeed.bodbAdminNet" >
      <Mapping DataField="SportType" ObjectProperty="Id" />
      <Mapping DataField="SportName" ObjectProperty="NameEnglish" />
      <Mapping DataField="SportNameCh" ObjectProperty="NameTraditionalChinese" />
      <Mapping DataField="SportNameCs" ObjectProperty="NameSimplifiedChinese" />
    </Setting>
    <Setting Key="SP.BetType" SpName="Odds_Partner_BetTypeSel" DbName="DBODDSFEED.bodb_OddsFeed.bodbAdminNet" >      
      <Mapping DataField="typeid" ObjectProperty="Id" />
      <Mapping DataField="typenamee" ObjectProperty="NameEnglish" />
      <Mapping DataField="typenameCh" ObjectProperty="NameTraditionalChinese" />
      <Mapping DataField="typenameCs" ObjectProperty="NameSimplifiedChinese" />
    </Setting>
    <Setting Key="SP.League" SpName="Odds_Partner_LeagueSel" DbName="DBODDSFEED.bodb_OddsFeed.bodbAdminNet" >
      <Mapping DataField="leaguename" ObjectProperty="NameEnglish" />
      <Mapping DataField="leaguenameCh" ObjectProperty="NameTraditionalChinese" />
      <Mapping DataField="leaguenameCs" ObjectProperty="NameSimplifiedChinese" />
      <Mapping DataField="SportType" ObjectProperty="SportId" />
      <Mapping DataField="SportName" ObjectProperty="SportName" />
    </Setting>
    
  </Function>
